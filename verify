  end

  local providers = {}
  if type(request) == "function" then
    providers[#providers + 1] = function()
      return request({ Url = url, Method = method, Headers = headers, Body = body })
    end
  end
  if type(http_request) == "function" then
    providers[#providers + 1] = function()
      return http_request({ Url = url, Method = method, Headers = headers, Body = body })
    end
  end
  if type(syn) == "table" and type(syn.request) == "function" then
    providers[#providers + 1] = function()
      return syn.request({ Url = url, Method = method, Headers = headers, Body = body })
    end
  end
  local okSvc, svc = pcall(function() return game:GetService("HttpService") end)
  if okSvc and svc then
    providers[#providers + 1] = function()
      return svc:RequestAsync({ Url = url, Method = method, Headers = headers, Body = body })
    end
  end

  if #providers == 0 and method ~= "GET" then
    return false, "executor HTTP istegi (request) desteklemiyor", 0
  end

  for _, provider in ipairs(providers) do
    local res, err = callWithTimeout(provider, TIMEOUT)
    if type(res) == "table" then
      local code = tonumber(res.StatusCode or res.Status or res.status_code or res.code) or 0
      local txt = res.Body or res.Content or res.body or res.text or ""
      if type(txt) ~= "string" then txt = tostring(txt) end
      if code >= 200 and code < 300 then return true, txt, code end
      if code > 0 then
        -- Sunucu cevap verdi ama hata döndü: diğer yöntemleri denemenin anlamı yok
        local d = jsonDecode(txt)
        local m = ""
        if type(d) == "table" and type(d.message) == "string" then
          m = " (" .. d.message:sub(1, 80) .. ")"
        end
        return false, "HTTP " .. tostring(code) .. m, code
      end
      lastErr = "gecersiz yanit"
    else
      lastErr = tostring(err or "yanit yok")
    end
  end

  return false, lastErr, 0
end

-- Boş yanıta izin veren ham GET
local function rawGet(url)
  local ok, body, code = httpReq(url, "GET", nil, { ["User-Agent"] = "loadsystem-lua" })
  if not ok then return nil, tostring(body) end
  if type(body) ~= "string" then return nil, "gecersiz yanit" end
  if body:sub(1, 14) == "404: Not Found" then return nil, "dosya bulunamadi (404)" end
  return body
end

local function fetchText(url)
  local body, err = rawGet(url)
  if not body then return nil, err end
  if #body < 3 then return nil, "bos yanit" end
  return body
end

--------------------------------------------------------------
-- GITHUB API
--------------------------------------------------------------
local function ghHeaders(token)
  local h = {
    ["Accept"] = "application/vnd.github+json",
    ["X-GitHub-Api-Version"] = "2022-11-28",
    ["User-Agent"] = "loadsystem-lua",
  }
  if token and token ~= "" then h["Authorization"] = "Bearer " .. token end
  return h
end

local function ghGetFile(path, token)
  local url = API_BASE .. path .. "?ref=" .. BRANCH .. "&t=" .. tostring(os.time())
  local ok, body = httpReq(url, "GET", nil, ghHeaders(token))
  if not ok then return nil, tostring(body) end
  local data = jsonDecode(body)
  if type(data) ~= "table" or not data.sha then return nil, "geçersiz yanıt" end
  local content = ""
  if type(data.content) == "string" then
    content = b64decode((data.content:gsub("%s", "")))
  end
  return { sha = data.sha, content = content }
end

-- Dönüş: true, yeniSha, kod  |  false, hata, kod
local function ghPutFile(path, content, sha, token, message)
  local payload = jsonEncode({
    message = message or ("loadsystem: update " .. path),
    content = b64encode(content),
    sha = sha,
    branch = BRANCH,
  })
  local ok, body, code = httpReq(API_BASE .. path, "PUT", payload, ghHeaders(token))
  if not ok then return false, tostring(body), code end
  local data = jsonDecode(body)
  if type(data) == "table" and data.content and data.content.sha then
    return true, data.content.sha, code
  end
  return false, "beklenmeyen yanıt", code
end

local function fetchRepoFile(path, token)
  local raw, e1 = fetchText(RAW_BASE .. path .. "?t=" .. tostring(os.time()))
  if raw then return raw end
  local info, e2 = ghGetFile(path, token)
  if info and type(info.content) == "string" and #info.content > 0 then
    return info.content
  end
  return nil, "raw: " .. tostring(e1) .. " | api: " .. tostring(e2 or "bos icerik")
end

--------------------------------------------------------------
-- OYUNCU LİSTESİ (player dosyası)
-- Satır biçimi: player:(isim)/playert:(takma ad)/password:(şifre)
--------------------------------------------------------------
-- Kayıtta yasak karakterler: boşluk, kontrol karakterleri ve bunlar:  / ( ) [ ] { } < > " ' `
local BAD = "[%(%)%[%]%{%}<>\"'`/%s%c]"
local BAD_MSG = "Takma ad ve şifre boşluk veya şu karakterleri içeremez: / ( ) [ ] { } < > \" ' `"

local function stripBad(s)
  return (tostring(s or ""):gsub(BAD, ""))
end

local function parsePlayers(text)
  local list = {}
  for line in (text or ""):gmatch("[^\r\n]+") do
    line = line:gsub("^%s+", ""):gsub("%s+$", "")
    if line ~= "" then
      local rec = {}
      local fields = 0
      for field in line:gmatch("[^/]+") do
        fields = fields + 1
        local k, v = field:match("^([^:]+):(.*)$")
        if k then
          k = k:gsub("^%s+", ""):gsub("%s+$", ""):lower()
          rec[k] = v
        end
      end
      if fields >= 3 and rec.player and rec.playert and rec.password then
        list[#list + 1] = { player = rec.player, playert = rec.playert, password = rec.password }
      end
    end
  end
  return list
end

-- Dönüş: liste, info(sha+içerik veya nil)  |  {}, nil, hataMetni
local function readPlayers(token)
  local info, err = ghGetFile(FILE_PLAYER, token)
  if info then
    return parsePlayers(info.content), info
  end
  local raw, err2 = rawGet(RAW_BASE .. FILE_PLAYER .. "?t=" .. tostring(os.time()))
  if raw then return parsePlayers(raw), nil end
  return {}, nil, "api: " .. tostring(err) .. " | raw: " .. tostring(err2)
end

-- Eski kayıtlarda yasak karakterler silinmiş olabilir: ham ve temizlenmiş biçimi de dene
local function findPlayer(list, nick, pass)
  local n1 = string.lower(nick or "")
  local n2 = string.lower(stripBad(nick))
  local p1 = pass or ""
  local p2 = stripBad(pass)
  for _, rec in ipairs(list) do
    local rn = string.lower(rec.playert or "")
    if (rn == n1 or rn == n2) and (rec.password == p1 or rec.password == p2) then
      return rec
    end
  end
  return nil
end

local function appendLine(content, line)
  content = content or ""
  if content == "" then
    return line .. "\n"
  elseif content:sub(-1) == "\n" then
    return content .. line .. "\n"
  end
  return content .. "\n" .. line .. "\n"
end

local function nicknameTaken(list, nick)
  local target = string.lower(nick or "")
  for _, rec in ipairs(list) do
    if string.lower(rec.playert or "") == target then return true end
  end
  return false
end

local function getPlayerName()
  for _ = 1, 10 do
    local ok, plr = pcall(function() return Players.LocalPlayer end)
    if ok and plr then
      local name = plr.Name
      if not name or name == "" then name = plr.DisplayName end
      if name and name ~= "" then return name end
    end
    sleep(0.2)
  end
  return "Player"
end

