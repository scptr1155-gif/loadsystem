local function httpGetNative(url)
  -- Roblox native GET: executor ortaminda en guvenilir yol (header gonderemez)
  local ok, res = pcall(function() return game:HttpGet(url) end)
  if not ok or type(res) ~= "string" or #res == 0 then return nil end
  if res:sub(1, 14) == "404: Not Found" then return nil end
  return res
end

-- Executor istek fonksiyonlari askida kalabilir; zaman asimi ile kesilir.
local function callWithTimeout(fn, timeout)
  local box = { done = false }
  task.spawn(function()
    local ok, a, b = pcall(fn)
    box.ok, box.a, box.b = ok, a, b
    box.done = true
  end)
  local waited = 0
  while (not box.done) and waited < timeout do
    sleep(0.05)
    waited = waited + 0.05
  end
  if not box.done then return nil end
  if not box.ok then return nil, tostring(box.a) end
  return { box.a, box.b }
end

local function httpReq(url, method, body, headers)
  method = (method or "GET"):upper()
  headers = headers or {}
  local needAuth = headers["Authorization"] ~= nil
  local lastErr = "bilinmeyen hata"
  local TIMEOUT = 12

  -- 1) game:HttpGet (yalnizca GET ve auth gerektirmiyorsa)
  if method == "GET" and not needAuth then
    local res = httpGetNative(url)
    if res then return true, res, 200 end
    lastErr = "game:HttpGet basarisiz"
  end

  -- 2) Executor ve oyun ici HTTP saglayicilari (zaman asimli)
  local providers = {}
  if type(request) == "function" then
    providers[#providers + 1] = function()
      return request({ Url = url, Method = method, Headers = headers, Body = body })
    end
  end
  if type(http_request) == "function" then
    providers[#providers + 1] = function()
      return http_request(url, method, headers, body)
    end
  end
  if type(syn) == "table" and type(syn.request) == "function" then
    providers[#providers + 1] = function()
      return syn.request({ Url = url, Method = method, Headers = headers, Body = body })
    end
  end
  if type(http) == "table" and type(http.get) == "function" then
    providers[#providers + 1] = function() return http.get(url) end
  end
  local okSvc, svc = pcall(function() return game:GetService("HttpService") end)
  if okSvc and svc then
    providers[#providers + 1] = function()
      return svc:RequestAsync({ Url = url, Method = method, Headers = headers, Body = body })
    end
  end

  for _, provider in ipairs(providers) do
    local res = callWithTimeout(provider, TIMEOUT)
    if res == nil then
      lastErr = "zaman asimi"
    else
      local a, b = res[1], res[2]
      if type(a) == "table" then
        local code = tonumber(a.StatusCode or a.Status or a.code or a.status_code or 0) or 0
        local txt = a.Body or a.Content or a.body or a.text or ""
        if type(txt) ~= "string" then txt = tostring(txt) end
        if code >= 200 and code < 300 then return true, txt, code end
        lastErr = "HTTP " .. tostring(code)
      elseif type(a) == "string" then
        local code = tonumber(b) or 0
        if code >= 200 and code < 300 then return true, a, code end
        lastErr = "HTTP " .. tostring(code)
      end
    end
  end

  return false, lastErr, 0
end

local function fetchText(url)
  local ok, body, code = httpReq(url, "GET", nil, { ["User-Agent"] = "loadsystem-lua" })
  if not ok then
    return nil, "HTTP " .. tostring(code)
  end
  if not body or #body < 3 then
    return nil, "bos yanit"
  end
  if body:sub(1, 14) == "404: Not Found" then
    return nil, "dosya bulunamadi (404)"
  end
  return body
end

--------------------------------------------------------------
-- GITHUB API
--------------------------------------------------------------
local function ghHeaders(token)
  local h = {
    ["Accept"] = "application/vnd.github+json",
    ["X-GitHub-Api-Version"] = "2022-11-28",
    ["User-Agent"] = "loadsystem-lua",
  }
  if token and token ~= "" then h["Authorization"] = "Bearer " .. token end
  return h
end

local function ghGetFile(path, token)
  -- "t" parametresi CDN onbellegini atlatir (yazma sonrasi bayat okuma olmasin)
  local url = API_BASE .. path .. "?ref=" .. BRANCH .. "&t=" .. tostring(os.time())
  local ok, body, code = httpReq(url, "GET", nil, ghHeaders(token))
  if not ok then return nil, "HTTP " .. tostring(code) end
  local data = jsonDecode(body)
  if type(data) ~= "table" or not data.sha then return nil, "ge\u{00E7}ersiz yan\u{0131}t" end
  local content = ""
  if type(data.content) == "string" then
    content = b64decode((data.content:gsub("%s", "")))
  end
  return { sha = data.sha, content = content }
end

local function ghPutFile(path, content, sha, token, message)
  local payload = jsonEncode({
    message = message or ("loadsystem: update " .. path),
    content = b64encode(content),
    sha = sha,
    branch = BRANCH,
  })
  local ok, body, code = httpReq(API_BASE .. path, "PUT", payload, ghHeaders(token))
  if not ok then return false, "HTTP " .. tostring(code), code end
  local data = jsonDecode(body)
  if type(data) == "table" and data.content and data.content.sha then
    return true, data.content.sha, code
  end
  return false, "beklenmeyen yan\u{0131}t", code
end

--------------------------------------------------------------
-- REPO DOSYASI (once API: CDN cache'i yok, anlik guncel; hata olursa ham dosya)
--------------------------------------------------------------
local function fetchRepoFile(path, token)
  -- Once ham dosya (game:HttpGet / executor GET): en guvenilir yol, header gerekmez
  local raw = fetchText(RAW_BASE .. path)
  if raw and #raw > 0 then return raw end
  -- Sonra API (base64 + json)
  local info = ghGetFile(path, token)
  if info and type(info.content) == "string" and #info.content > 0 then
    return info.content
  end
  return nil, "icerik alinamadi"
end

--------------------------------------------------------------
-- OYUNCU L\u{0131}STES\u{0130} (player dosyas\u{0131})
-- Bi\u{00E7}im sat\u{0131}r: player:(isim)/playert:(takma ad)/password:(\u{015F}ifre)
--------------------------------------------------------------
local function parsePlayers(text)
  local list = {}
  for line in (text or ""):gmatch("[^\r\n]+") do
    line = line:gsub("^%s+", ""):gsub("%s+$", "")
    if line ~= "" then
      local rec = {}
      local fields = 0
      for field in line:gmatch("[^/]+") do
        fields = fields + 1
        local k, v = field:match("^([^:]+):(.*)$")
        if k then
          k = k:gsub("^%s+", ""):gsub("%s+$", ""):lower()
          rec[k] = v
        end
      end
      if fields >= 3 and rec.player and rec.playert and rec.password then
        list[#list + 1] = { player = rec.player, playert = rec.playert, password = rec.password }
      end
    end
  end
  return list
end

local function readPlayers(token)
  -- \u{00D6}ncelikle i\u{00E7}erik API (sha laz\u{0131}m), yetmezse ham dosya
  -- ONCE API: raw.githubusercontent 5 dk onbellek tutar, yeni kayitlar
  -- (yeni hesaplar) ancak API'den aninda gorunur. Sira onemli!
  local info, err = ghGetFile(FILE_PLAYER, token)
  if info then
    return parsePlayers(info.content), info
  end
  -- API erisilemiyorsa ham dosya (bayat olabilir ama hic yoksa iyi)
  local raw = fetchText(RAW_BASE .. FILE_PLAYER)
  if raw then return parsePlayers(raw), nil end
  return {}, nil, err
end

local function findPlayer(list, nick, pass)
  local target = string.lower(nick or "")
  for _, rec in ipairs(list) do
    if string.lower(rec.playert or "") == target and rec.password == pass then
      return rec
    end
  end
  return nil
end

local function appendLine(content, line)
  content = content or ""
  if content == "" then
    return line .. "\n"
  elseif content:sub(-1) == "\n" then
    return content .. line .. "\n"
  end
  return content .. "\n" .. line .. "\n"
end

local function nicknameTaken(list, nick)
  local target = string.lower(nick or "")
  for _, rec in ipairs(list) do
    if string.lower(rec.playert or "") == target then return true end
  end
  return false
end

