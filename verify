local function sleep(s)
  s = s or 0
  if type(task) == "table" and type(task.wait) == "function" then task.wait(s)
  elseif type(wait) == "function" then wait(s) end
end

local function spawn(fn, ...)
  if type(task) == "table" and type(task.spawn) == "function" then return task.spawn(fn, ...)
  end
  local co = coroutine.create(fn)
  coroutine.resume(co, ...)
  return co
end

