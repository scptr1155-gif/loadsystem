-- Tek yanlış özellik tüm arayüzü çökertmesin
local function mk(class, props, parent)
  local ok, o = pcall(function() return Instance.new(class) end)
  if not ok or not o then return nil end
  for k, v in pairs(props or {}) do
    pcall(function() o[k] = v end)
  end
  if parent then pcall(function() o.Parent = parent end) end
  return o
end

local function getService(name)
  local ok, s = pcall(function() return game:GetService(name) end)
  if ok and s then return s end
  return nil
end

local Players      = getService("Players")
local TweenService = getService("TweenService")
local CoreGui      = getService("CoreGui")

local function attachGui(gui)
  if CoreGui then
    local ok = pcall(function() gui.Parent = CoreGui end)
    if ok then return true end
  end
  local ok2 = pcall(function()
    local lp = Players and Players.LocalPlayer
    if not lp then error("LocalPlayer yok") end
    gui.Parent = lp:WaitForChild("PlayerGui")
  end)
  return ok2
end

