local TOKEN = nil
local panel = nil

-- Derleme hatasında hatalı satırı ve dosyanın ilk satırını konsola yazar
local function loadChunk(code, label)
  if type(code) ~= "string" or code == "" then return nil, "bos kod" end
  local chunk, err
  if type(loadstring) == "function" then
    chunk, err = loadstring(code, label)
  elseif type(load) == "function" then
    chunk, err = load(code, label)
  else
    return nil, "loadstring bulunamadi"
  end
  if not chunk then
    local ln = tonumber(tostring(err):match(":(%d+):"))
    local n = 0
    for line in (code .. "\n"):gmatch("(.-)\n") do
      n = n + 1
      if n == 1 or n == ln then
        print("[loadsystem] " .. tostring(label) .. " satir " .. n .. ": " .. line:sub(1, 120))
      end
    end
    print("[loadsystem] " .. tostring(label) .. " uzunluk: " .. #code)
    return nil, tostring(err)
  end
  local ok, mod = pcall(chunk)
  if not ok then return nil, tostring(mod) end
  return mod
end

local function waitFor(cond, timeout)
  local waited = 0
  while waited < timeout do
    if cond() then return true end
    sleep(0.1)
    waited = waited + 0.1
  end
  return cond()
end

local function charLen(s)
  if type(utf8) == "table" and type(utf8.len) == "function" then
    local ok, n = pcall(utf8.len, s)
    if ok and n then return n end
  end
  return #s
end

local function sanitizeName(s)
  s = tostring(s or "")
  s = s:gsub(BAD, "")
  return s
end

local function validate(name, nick, pass)
  if not name or name == "" then return false, "Oyuncu adı bulunamadı." end
  if not nick or nick == "" then return false, "Takma ad boş olamaz." end
  local nl = charLen(nick)
  if nl < 3 or nl > 20 then return false, "Takma ad 3-20 karakter olmalı." end
  if nick:find(BAD) then return false, BAD_MSG end
  if not pass or pass == "" then return false, "Şifre boş olamaz." end
  if #pass < 4 or #pass > 64 then return false, "Şifre 4-64 karakter olmalı." end
  if pass:find(BAD) then return false, BAD_MSG end
  return true
end

local function dummyCurtain()
  local noop = function() end
  return {
    setText = noop,
    fadeIn = noop,
    fadeOut = noop,
    setRetry = noop,
    error = function(text) print("[loadsystem] " .. tostring(text)) end,
  }
end

local function proceedToMainMenu(session)
  -- Çift tetiklenmeye karşı: main-menu yalnızca bir kez yüklenir
  if S.PROCEEDING then return end
  S.PROCEEDING = true

  sleep(0.4)
  if panel and panel.isOpen and panel.isOpen() then pcall(function() panel.close() end) end
  sleep(0.2)

  local okC, curtain = pcall(buildCurtain)
  if not okC or type(curtain) ~= "table" then
    print("[loadsystem] perde olusturulamadi: " .. tostring(curtain))
    curtain = dummyCurtain()
  end
  curtain.fadeIn(0.35)
  sleep(0.25)

  local function attempt()
    curtain.setText("LOADING MAIN MENU", "ARAYUZ YUKLENIYOR")
    local code, err = fetchRepoFile(FILE_MENU, TOKEN)
    if not code then
      print("[loadsystem] main-menu indirilemedi: " .. tostring(err))
      curtain.error("MAIN MENU YUKLENEMEDI", tostring(err):sub(1, 140))
      return
    end

    S.MAIN_READY = nil

    local mod, lerr = loadChunk(code, FILE_MENU)
    if not mod then
      print("[loadsystem] main-menu hatasi: " .. tostring(lerr))
      curtain.error("MAIN MENU HATASI", tostring(lerr):sub(1, 140))
      return
    end
    local ready = waitFor(function()
      return S.MAIN_READY == true
    end, 20)
    if not ready then
      print("[loadsystem] main-menu calisti ama __LOADSYS.MAIN_READY = true yapmadi")
      curtain.error("MAIN MENU BASLAMADI", "main-menu MAIN_READY isaretini koymadi")
      return
    end
    S.MAIN = mod
    curtain.setText("HAZIR", "HOŞ GELDİN")
    sleep(0.35)
    curtain.fadeOut(0.5)
  end

  curtain.setRetry(function() spawn(attempt) end)
  attempt()
end

local function onLogin(nick, pass)
  if S.PROCEEDING then return true, "Giriş başarılı." end
  local list, _, rerr = readPlayers(TOKEN)
  if #list == 0 and rerr then
    return false, "Sunucuya ulaşılamadı: " .. tostring(rerr):sub(1, 90)
  end
  local rec = findPlayer(list, nick, pass)
  if not rec then
    return false, "Takma ad veya şifre hatalı."
  end
  local session = { player = rec.player, playert = rec.playert, time = os.time() }
  S.SESSION = session
  spawn(function() proceedToMainMenu(session) end)
  return true, "Giriş başarılı."
end

local function onRegister(name, nick, pass)
  if S.PROCEEDING then return true, "Hesap oluşturuldu." end

  name = sanitizeName(name)
  local ok, msg = validate(name, nick, pass)
  if not ok then return false, msg end
  if not TOKEN or TOKEN == "" then
    return false, "Sunucu erişimi yok (API anahtarı çözülemedi). Giriş yapabilirsin ama kayıt kapalı."
  end

  local list, info, rerr = readPlayers(TOKEN)
  if rerr then
    return false, "Oyuncu listesi okunamadı: " .. tostring(rerr):sub(1, 90)
  end
  if nicknameTaken(list, nick) then
    return false, "Bu takma ad zaten alınmış."
  end

  -- Mevcut içerik bilinmiyorsa ÜZERİNE YAZMA (veri kaybı olmasın)
  if not info or type(info.content) ~= "string" or not info.sha then
    return false, "Oyuncu listesi okunamadı, kayıt yapılmadı (mevcut veriler korundu)."
  end

  local line = "player:" .. name .. "/playert:" .. nick .. "/password:" .. pass
  local cur = info
  local wrote, werr, wcode = false, "bilinmeyen hata", 0
  for _ = 1, 3 do
    wrote, werr, wcode = ghPutFile(FILE_PLAYER, appendLine(cur.content, line), cur.sha, TOKEN, "loadsystem: add player " .. nick)
    if wrote then break end
    -- 409/422: biri aynı anda yazdı. Dosyayı yeniden okuyup tekrar dene.
    if wcode ~= 409 and wcode ~= 422 then break end
    sleep(0.6)
    local re = ghGetFile(FILE_PLAYER, TOKEN)
    if not re then break end
    if nicknameTaken(parsePlayers(re.content), nick) then
      return false, "Bu takma ad zaten alınmış."
    end
    cur = re
  end
  if not wrote then
    return false, "Yazma hatası: " .. tostring(werr):sub(1, 90)
  end

  local session = { player = name, playert = nick, time = os.time() }
  S.SESSION = session
  spawn(function() proceedToMainMenu(session) end)
  return true, "Hesap oluşturuldu."
end

local function main()
  panel = nil
  S.PROCEEDING = nil
  local boot = BOOT
  if not boot then
    boot = (function()
      local ok, b = safe(buildBoot)
      if ok and type(b) == "table" then return b end
      return nil
    end)()
  end
  if not boot then
    print("[loadsystem] ekran yok, akis iptal")
    return
  end
  S.boot = boot
  boot.reset()
  boot.setRetry(function()
    print("[loadsystem] tekrar deneniyor")
    spawn(main)
  end)
  print("[loadsystem] yukleme basladi")

  -- 1) API anahtarını çöz (sadece KAYIT için gerekir; çözülemese de giriş çalışır)
  TOKEN = decryptBlob(CIPHER.KEY, CIPHER.BLOB)
  if not TOKEN then
    print("[loadsystem] UYARI: API anahtari cozulemedi. Giris calisir, kayit kapali.")
  end

  -- 2) arayüzü indir
  boot.setText("LOADING", "ARAYUZ INDIRILIYOR")
  print("[loadsystem] arayuz indiriliyor")
  local code, err = fetchRepoFile(FILE_GUI, TOKEN)
  if not code then
    boot.fail("ARAYUZ YUKLENEMEDI", "verify-gui: " .. tostring(err or "bilinmeyen hata"))
    return
  end

  -- 3) arayüzü çalıştır
  print("[loadsystem] arayuz calistiriliyor (" .. #code .. " bayt)")
  S.__VERIFY_LOADING = true
  local GUI, lerr = loadChunk(code, FILE_GUI)
  S.__VERIFY_LOADING = nil
  if not GUI or type(GUI.build) ~= "function" then
    boot.fail("ARAYUZ HATASI", "verify-gui: " .. tostring(lerr or "bilinmeyen hata"))
    return
  end
  S.GUI = GUI
  if GUI.__standalone and GUI.__standalonePanel then
    pcall(function() GUI.__standalonePanel.close() end)
  end

  -- 4) beyaz paneli kur
  print("[loadsystem] panel kuruluyor")
  local okBuild, panelOrErr = pcall(GUI.build, {
    username = getPlayerName(),
    onLogin = onLogin,
    onRegister = onRegister,
  })
  if not okBuild or type(panelOrErr) ~= "table" then
    boot.fail("ARAYUZ HATASI", tostring(panelOrErr))
    return
  end
  panel = panelOrErr

  -- 5) siyah ekranı animasyonla kaldır
  print("[loadsystem] panel hazir, siyah ekran kaldiriliyor")
  sleep(0.45)
  local okD, errD = pcall(function() GUI.dismissBoot() end)
  if not okD then
    print("[loadsystem] dismissBoot hatasi: " .. tostring(errD))
    -- perde ne olursa olsun kalkmalı
    pcall(function() boot.gui:Destroy() end)
  end
end

local okBoot, errBoot = pcall(main)
if not okBoot then
  pcall(function()
    if S.boot and S.boot.fail then
      S.boot.fail("SISTEM HATASI", tostring(errBoot))
    end
  end)
  print("[loadsystem] hata: " .. tostring(errBoot))
end

return {
  version = "1.2.0",
  session = function() return S.SESSION end,
}
