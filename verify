-- JSON (saf Lua)
--------------------------------------------------------------
local function jsonEscape(s)
  s = tostring(s)
  s = s:gsub("\\", "\\\\"):gsub('"', '\\"')
  s = s:gsub("\n", "\\n"):gsub("\r", "\\r"):gsub("\t", "\\t")
  s = s:gsub("[\1-\31]", function(c)
    return string.format("\\u%04x", string.byte(c))
  end)
  return s
end

local function jsonEncode(v)
  local t = type(v)
  if v == nil then return "null" end
  if t == "boolean" then return tostring(v) end
  if t == "number" then
    if v == math.floor(v) and math.abs(v) < 1e15 then return string.format("%d", v) end
    return string.format("%.14g", v)
  end
  if t == "string" then return '"' .. jsonEscape(v) .. '"' end
  if t == "table" then
    local count, max, isArray = 0, 0, true
    for k in pairs(v) do
      if type(k) ~= "number" then isArray = false break end
      count = count + 1
      if k > max then max = k end
    end
    if isArray and count == max then
      local parts = {}
      for i = 1, max do parts[i] = jsonEncode(v[i]) end
      return "[" .. table.concat(parts, ",") .. "]"
    end
    local keys = {}
    for k in pairs(v) do keys[#keys + 1] = tostring(k) end
    table.sort(keys)
    local parts = {}
    for _, k in ipairs(keys) do
      local val = v[k]
      if val == nil then val = v[tonumber(k) or 0] end
      parts[#parts + 1] = '"' .. jsonEscape(k) .. '":' .. jsonEncode(val)
    end
    return "{" .. table.concat(parts, ",") .. "}"
  end
  return "null"
end

local function jsonDecode(str)
  if type(str) ~= "string" then return nil end
  local pos, len = 1, #str

  local function skipWs()
    while pos <= len do
      local c = str:sub(pos, pos)
      if c == " " or c == "\t" or c == "\n" or c == "\r" then pos = pos + 1 else break end
    end
  end

  local function utf8Char(cp)
    if cp < 0x80 then return string.char(cp)
    elseif cp < 0x800 then
      return string.char(192 + math.floor(cp / 64), 128 + (cp % 64))
    elseif cp < 0x10000 then
      return string.char(224 + math.floor(cp / 4096), 128 + (math.floor(cp / 64) % 64), 128 + (cp % 64))
    end
    return string.char(240 + math.floor(cp / 262144), 128 + (math.floor(cp / 4096) % 64),
      128 + (math.floor(cp / 64) % 64), 128 + (cp % 64))
  end

  local function parseString()
    pos = pos + 1
    local buf = {}
    while pos <= len do
      local c = str:sub(pos, pos)
      if c == '"' then pos = pos + 1 break end
      if c == "\\" then
        pos = pos + 1
        local e = str:sub(pos, pos)
        pos = pos + 1
        if e == "n" then buf[#buf + 1] = "\n"
        elseif e == "t" then buf[#buf + 1] = "\t"
        elseif e == "r" then buf[#buf + 1] = "\r"
        elseif e == "b" then buf[#buf + 1] = "\b"
        elseif e == "f" then buf[#buf + 1] = "\f"
        elseif e == "/" then buf[#buf + 1] = "/"
        elseif e == "\\" then buf[#buf + 1] = "\\"
        elseif e == '"' then buf[#buf + 1] = '"'
        elseif e == "u" then
          local hex = str:sub(pos, pos + 3)
          pos = pos + 4
          local cp = tonumber(hex, 16) or 63
          if cp >= 0xD800 and cp <= 0xDBFF and str:sub(pos, pos + 1) == "\\u" then
            local lo = tonumber(str:sub(pos + 2, pos + 5), 16)
            if lo and lo >= 0xDC00 and lo <= 0xDFFF then
              cp = 0x10000 + (cp - 0xD800) * 0x400 + (lo - 0xDC00)
              pos = pos + 6
            end
          end
          buf[#buf + 1] = utf8Char(cp)
        else
          buf[#buf + 1] = e
        end
      else
        buf[#buf + 1] = c
        pos = pos + 1
      end
    end
    return table.concat(buf)
  end

  local function parseNumber()
    local s = pos
    while pos <= len do
      local c = str:sub(pos, pos)
      if c:match("[%d%+%-%.%deE]") then pos = pos + 1 else break end
    end
    return tonumber(str:sub(s, pos - 1))
  end

  local parseValue

  local function parseArray()
    local arr = {}
    pos = pos + 1
    skipWs()
    if str:sub(pos, pos) == "]" then pos = pos + 1 return arr end
    while pos <= len do
      arr[#arr + 1] = parseValue()
      skipWs()
      local c = str:sub(pos, pos)
      if c == "," then pos = pos + 1
      elseif c == "]" then pos = pos + 1 break
      else break end
    end
    return arr
  end

  local function parseObject()
    local obj = {}
    pos = pos + 1
    skipWs()
    if str:sub(pos, pos) == "}" then pos = pos + 1 return obj end
    while pos <= len do
      skipWs()
      if str:sub(pos, pos) ~= '"' then break end
      local key = parseString()
      skipWs()
      if str:sub(pos, pos) == ":" then pos = pos + 1 end
      local val = parseValue()
      obj[key] = val
      skipWs()
      local c = str:sub(pos, pos)
      if c == "," then pos = pos + 1
      elseif c == "}" then pos = pos + 1 break
      else break end
    end
    return obj
  end

  parseValue = function()
    skipWs()
    if pos > len then return nil end
    local c = str:sub(pos, pos)
    if c == "{" then return parseObject() end
    if c == "[" then return parseArray() end
    if c == '"' then return parseString() end
    if str:sub(pos, pos + 3) == "true" then pos = pos + 4 return true end
    if str:sub(pos, pos + 4) == "false" then pos = pos + 5 return false end
    if str:sub(pos, pos + 3) == "null" then pos = pos + 4 return nil end
    return parseNumber()
  end

  local ok, res = pcall(parseValue)
  if not ok then return nil end
  return res
end

--------------------------------------------------------------
-- \u{015E}ifRELEME (GitHub PAT)
-- Anahtar par\u{00E7}alar\u{0131} + XOR/ekleme katmanlar\u{0131} + CRC benzeri b\u{00FC}t\u{00FC}nl\u{00FC} kontrol\u{00FC}.
--------------------------------------------------------------
-- Şifreleme (GitHub PAT)
-- DIKKAT: Luau'da native bitwise operatörler (& | ~ << >>) YOKTUR,
-- sadece `bit32` kütüphanesi vardır. Bu yüzden XOR elle uygulanır;
-- bit32 varsa o kullanılır, yoksa saf Lua fallback devreye girer.
--------------------------------------------------------------
local U32 = 0xFFFFFFFF

local function u32(x)
  x = x % 4294967296
  if x < 0 then x = x + 4294967296 end
  return x
end

local BIT32 = (type(bit32) == "table") and bit32 or nil

-- 32-bit XOR
local function bxor32(a, b)
  if BIT32 and type(BIT32.bxor) == "function" then
    return BIT32.bxor(u32(a), u32(b))
  end
  a, b = u32(a), u32(b)
  local res, bitv = 0, 1
  for _ = 1, 32 do
    local ab, bb = a % 2, b % 2
    if ab ~= bb then res = res + bitv end
    a = (a - ab) / 2
    b = (b - bb) / 2
    bitv = bitv * 2
  end
  return res
end

local function mix32(seed, byte)
  seed = bxor32(seed, byte)
  seed = u32(seed * 31 + 0x9E3779B9)
  return seed
end

local function keySeed(key)
  local seed = 0x811C9DC5
  for i = 1, #key do seed = mix32(seed, key:byte(i)) end
  return seed
end

local function checksum(data)
  local h = 0x811C9DC5
  for i = 1, #data do h = mix32(h, data:byte(i)) end
  return h
end

local function keystream(key, n)
  local state = keySeed(key)
  local out = {}
  for i = 1, n do
    local x = state
    x = bxor32(x, u32(x * 8192))         -- x << 13
    x = bxor32(x, math.floor(x / 131072)) -- x >> 17
    x = bxor32(x, u32(x * 32))           -- x << 5
    state = u32(x)
    out[i] = string.char(state % 256)
  end
  return table.concat(out)
end

local function decryptBlob(keyParts, blob)
  local key = table.concat(keyParts or {})
  if key == "" or not blob or blob == "" then return nil end
  local enc = b64decode(blob)
  if #enc < 5 then return nil end
  local ks = keystream(key, #enc)
  local out = {}
  for i = 1, #enc do
    local kb = key:byte(((i - 1) % #key) + 1)
    local off = (kb + (i - 1) * 7) % 256
    local b = (enc:byte(i) - off) % 256
    if b < 0 then b = b + 256 end
    out[i] = string.char(bxor32(b, ks:byte(i)))
  end
  local data = table.concat(out)
  local sb = data:sub(1, 4)
  local stored = 0
  for i = 1, 4 do stored = stored * 256 + sb:byte(i) end
  local body = data:sub(5)
  if stored ~= checksum(body) then return nil end
  return body
end

