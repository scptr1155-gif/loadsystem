local TOKEN = nil
local panel = nil

local function loadChunk(code, label)
  if type(code) ~= "string" or code == "" then return nil, "bos kod" end
  local chunk, err
  if type(loadstring) == "function" then
    chunk, err = loadstring(code, label)
  elseif type(load) == "function" then
    chunk, err = load(code, label)
  else
    return nil, "loadstring bulunamadi"
  end
  if not chunk then return nil, tostring(err) end
  local ok, mod = pcall(chunk)
  if not ok then return nil, tostring(mod) end
  return mod
end

local function waitFor(cond, timeout)
  local waited = 0
  while waited < timeout do
    if cond() then return true end
    sleep(0.1)
    waited = waited + 0.1
  end
  return cond()
end

-- Kaydedilecek değerlerde "(" ")" gibi karakterler olmasın (satır formatı bozulmasın)
local function sanitize(s)
  s = tostring(s or "")
  s = s:gsub("[%(%)%[%]%{%}<>%\"'`]", "")
  s = s:gsub("[\r\n\t]", " ")
  s = s:gsub("%s+", " ")
  s = s:gsub("^%s+", "")
  s = s:gsub("%s+$", "")
  return s
end

local function validate(name, nick, pass)
  if not nick or nick == "" then return false, "Takma ad bo\u{015F} olamaz." end
  if #nick < 3 or #nick > 20 then return false, "Takma ad 3-20 karakter olmal\u{0131}." end
  if nick:find("[/%s]") then return false, "Takma ad '/' ve bo\u{015F}luk i\u{00E7}eremez." end
  if not pass or pass == "" then return false, "\u{015E}ifre bo\u{015F} olamaz." end
  if #pass < 4 or #pass > 64 then return false, "\u{015E}ifre 4-64 karakter olmal\u{0131}." end
  if pass:find("[/%s]") then return false, "\u{015E}ifre '/' ve bo\u{015F}luk i\u{00E7}eremez." end
  if not name or name == "" then return false, "Oyuncu ad\u{0131} bulunamad\u{0131}." end
  return true
end

local function proceedToMainMenu(session)
  sleep(0.4)
  if panel and panel.isOpen and panel.isOpen() then pcall(function() panel.close() end) end
  sleep(0.45)

  local curtain = buildCurtain()
  curtain.fadeIn(0.35)
  sleep(0.25)

  local function attempt()
    curtain.setText("LOADING MAIN MENU", "ARAYUZ YUKLENIYOR")
    local code, err = fetchRepoFile(FILE_MENU, TOKEN)
    if not code then
      curtain.error("MAIN MENU YUKLENEMEDI")
      return
    end
    local mod, lerr = loadChunk(code, FILE_MENU)
    if not mod then
      curtain.error("MAIN MENU HATASI")
      return
    end
    -- main-menu calistigini dogrula (hazir bayragi)
    local ready = waitFor(function()
      return S.MAIN_READY == true
    end, 20)
    if not ready then
      curtain.error("MAIN MENU BASLAMADI")
      return
    end
    S.MAIN = mod
    curtain.setText("HAZIR", "HO\u{015e} GELD\u{0130}N")
    sleep(0.35)
    curtain.fadeOut(0.5)
  end

  curtain.setRetry(function() attempt() end)
  attempt()
end

local function onLogin(nick, pass)
  local list = readPlayers(TOKEN)
  local rec = findPlayer(list, nick, pass)
  if not rec then
    return false, "Takma ad veya \u{015F}ifre hatal\u{0131}."
  end
  local session = { player = rec.player, playert = rec.playert, time = os.time() }
  S.SESSION = session
  spawn(function() proceedToMainMenu(session) end)
  return true, "Giri\u{015F} ba\u{015F}ar\u{0131}l\u{0131}."
end

local function onRegister(name, nick, pass)
  local ok, msg = validate(name, nick, pass)
  if not ok then return false, msg end
  if not TOKEN or TOKEN == "" then
    return false, "Sunucu eri\u{015F}imi yok (API anahtar\u{0131} \u{00E7}\u{00F6}z\u{00FC}lemedi)."
  end

  name = sanitize(name)
  nick = sanitize(nick)
  pass = sanitize(pass)
  if name == "" then return false, "Oyuncu adı bulunamadı." end
  if nick == "" then return false, "Takma ad boş olamaz." end
  if pass == "" then return false, "Şifre boş olamaz." end

  local list, info = readPlayers(TOKEN)
  if nicknameTaken(list, nick) then
    return false, "Bu takma ad zaten al\u{0131}nm\u{0131}\u{015F}."
  end

  -- Mevcut icerik bilinmiyorsa UZERME YAPMA: aksi halde dosyadaki tum
  -- hesaplar silinip sadece yeni satir kalir (veri kaybi).
  if not info or type(info.content) ~= "string" then
    return false, "Oyuncu listesi okunamadi, kayit yapilmadi (mevcut veriler korundu)."
  end

  local content = info.content
  local line = "player:" .. name .. "/playert:" .. nick .. "/password:" .. pass
  content = appendLine(content, line)

  local sha = info and info.sha or nil
  if not sha then
    -- sha bilgisi yoksa yeniden al
    local re = ghGetFile(FILE_PLAYER, TOKEN)
    if re then sha = re.sha end
  end
  if not sha then
    return false, "Dosya bilgisi al\u{0131}namad\u{0131}."
  end

  local wrote, werr, wcode = ghPutFile(FILE_PLAYER, content, sha, TOKEN, "loadsystem: add player " .. nick)
  if not wrote and wcode == 409 then
    -- sha cakismasi: dosya az once degismis olabilir -> yeniden oku ve tekrar dene
    local re = ghGetFile(FILE_PLAYER, TOKEN)
    if re then
      local content2 = appendLine(re.content, line)
      wrote, werr, wcode = ghPutFile(FILE_PLAYER, content2, re.sha, TOKEN, "loadsystem: add player " .. nick)
    end
  end
  if not wrote then
    return false, "Yazma hatas\u{0131}: " .. tostring(werr)
  end

  local session = { player = name, playert = nick, time = os.time() }
  S.SESSION = session
  spawn(function() proceedToMainMenu(session) end)
  return true, "Hesap olu\u{015F}turuldu."
end

local function main()
  panel = nil
  local boot = BOOT
  if not boot then
    boot = (function()
      local ok, b = safe(buildBoot)
      if ok and type(b) == "table" then return b end
      return nil
    end)()
  end
  if not boot then
    print("[loadsystem] ekran yok, akis iptal")
    return
  end
  S.boot = boot
  boot.reset()
  boot.setRetry(function()
    print("[loadsystem] tekrar deneniyor")
    spawn(main)
  end)
  print("[loadsystem] yukleme basladi")

  -- 1) API anahtarini coz
  TOKEN = decryptBlob(CIPHER.KEY, CIPHER.BLOB)
  if not TOKEN then
    boot.fail("API ANAHTARI COZULEMEDI", "Sifreleme katmani hata verdi. Dosya bozuk olabilir.")
    return
  end

  -- 2) arayuzu indir
  boot.setText("LOADING", "ARAYUZ INDIRILIYOR")
  print("[loadsystem] arayuz indiriliyor")
  local code, err = fetchRepoFile(FILE_GUI, TOKEN)
  if not code then
    boot.fail("ARAYUZ YUKLENEMEDI", "verify-gui: " .. tostring(err or "bilinmeyen hata"))
    return
  end

  -- 3) arayuzu calistir
  print("[loadsystem] arayuz calistiriliyor")
  S.__VERIFY_LOADING = true
  local GUI, lerr = loadChunk(code, FILE_GUI)
  S.__VERIFY_LOADING = nil
  if not GUI or type(GUI.build) ~= "function" then
    boot.fail("ARAYUZ HATASI", "verify-gui: " .. tostring(lerr or "bilinmeyen hata"))
    return
  end
  S.GUI = GUI
  -- verify-gui tek basina calistirilip demo panel acmisse onu kapat
  if GUI.__standalone and GUI.__standalonePanel then
    pcall(function() GUI.__standalonePanel.close() end)
  end

  -- 4) beyaz paneli kur
  print("[loadsystem] panel kuruluyor")
  local okBuild, panelOrErr = pcall(GUI.build, {
    username = getPlayerName(),
    onLogin = onLogin,
    onRegister = onRegister,
  })
  if not okBuild or type(panelOrErr) ~= "table" then
    boot.fail("ARAYUZ HATASI", tostring(panelOrErr))
    return
  end
  panel = panelOrErr

  -- 5) siyah ekrani animasyonla kaldir
  print("[loadsystem] panel hazir, siyah ekran kaldiriliyor")
  sleep(0.45)
  pcall(function() GUI.dismissBoot() end)
end

local okBoot, errBoot = pcall(main)
if not okBoot then
  pcall(function()
    if S.boot and S.boot.fail then
      S.boot.fail("SISTEM HATASI", tostring(errBoot))
    end
  end)
  print("[loadsystem] hata: " .. tostring(errBoot))
end

return {
  version = "1.1.0",
  session = function() return S.SESSION end,
}
