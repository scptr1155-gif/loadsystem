-- Temel yardimcilar (tum erisimler korumali)
local function mk(class, props)
  local ok, o = safe(function() return Instance.new(class) end)
  if not ok or not o then return nil end
  for k, v in pairs(props or {}) do
    safe(function() o[k] = v end)
  end
  return o
end

