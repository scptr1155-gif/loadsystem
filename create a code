--------------------------------------------------------------
local function readKeys()
  local ok, src = pcall(function() return game:HttpGet(KEY_URL .. "?t=" .. tostring(os.time())) end)
  if not ok or type(src) ~= "string" or src:sub(1, 14) == "404: Not Found" then
    print("[create] api-key okunamadi")
    return {}, "api-key okunamadi"
  end

  local keys = {}
  for line in (src .. "\n"):gmatch("(.-)\n") do
    line = trim(line)
    if line ~= "" and line:sub(1, 1) ~= "#" then
      -- tırnakları temizle
      line = line:gsub("[\"'`]", "")
      -- "Bearer xxx" / "token xxx" / "Bearer: xxx" önekleri (boşluklar silinmeden ÖNCE)
      line = trim(line)
      line = line:gsub("^[Bb][Ee][Aa][Rr][Ee][Rr]:?%s*", "")
      line = line:gsub("^[Tt][Oo][Kk][Ee][Nn]:?%s*", "")
      line = line:gsub("%s+", "")

      if line:sub(1, 4) == "rev:" then line = line:sub(5):reverse()
      elseif line:sub(1, 4) == "b64:" then line = b64decode(line:sub(5)) end

      line = line:gsub("%s+", "")
      if #line >= 20 then keys[#keys + 1] = line end
    end
  end

  print("[create] okunan anahtar sayisi: " .. #keys)
  local info = {}
  for i, k in ipairs(keys) do
    print("[create] anahtar " .. i .. ": " .. k:sub(1, 4) .. "... (uzunluk " .. #k .. ")")
    info[#info + 1] = k:sub(1, 4) .. "…/" .. #k
  end
  return keys, #keys .. " | " .. table.concat(info, ", ")
end

