-- create a code | SCRIPT OLUŞTUR VE YAYINLA (v3.1)
-- =========================================================
-- scripthub'daki CREATE tuşu bu dosyayı indirir ve open(ctx) çağırır.
-- v3.1:
-- * Her kayda ownerNick (yayınlayan takma ad) eklenir; Studio/Profil bunu kullanır.
--   owner (UserId) bilgi olarak saklanmaya devam eder.
-- * Günlük 1 script limiti artık TAKMA AD başınadır (UTC günü).
-- v3.0:
-- * YAYINLA'ya basınca 60 sn'lik bekleme ekranı açılır; yayın bu sürede arka planda yapılır.
--   Yayın hata verirse beklemeden hata gösterilir.
-- * Günde 1 script (UTC günü). Hak bittiyse beklemeye hiç girmez.
-- * GitHub/JSON/api-key mantığı artık hubcore içinde.
--
-- Not: api-key dosyası herkese açık depodaysa anahtarı herkes okuyabilir (ters yazmak gizlemez).

local G = (type(getgenv) == "function" and getgenv()) or _G
local S = G.__LOADSYS or {}
G.__LOADSYS = S

local BASE = "https://raw.githubusercontent.com/scptr1155-gif/loadsystem/refs/heads/main/"
local WAIT = 60
local NEED = "1.3"

local function loadCore()
  if type(S.CORE) == "table" and S.CORE.version == NEED then return S.CORE end
  local ok, src = pcall(function() return game:HttpGet(BASE .. "hubcore?t=" .. tostring(os.time())) end)
  if not ok or type(src) ~= "string" or type(loadstring) ~= "function" then return nil end
  local fn = loadstring(src)
  if not fn then return nil end
  local okR, c = pcall(fn)
  if okR and type(c) == "table" then return c end
  return nil
end

local STR = {
  tr = {
    back = "← GERİ", title = "Script Oluştur", sub = "Scriptini yayınla; ID ile herkes çağırabilsin",
    f_name = "Script adı", f_image = "Resim ID (rbxassetid)", f_desc = "Açıklama", f_code = "Script kodu (Lua)",
    publish = "YAYINLA", publishing = "Yayınlanıyor...",
    ld_pub = "SCRIPT YAYINLANIYOR", ld_wait = "Lütfen bekle", ld_done = "Yayın tamamlandı, son kontroller...",
    bad_name = "Script adı 3-40 karakter olmalı.", bad_code = "Script kodu boş olamaz.",
    bad_syntax = "Kodda sözdizimi hatası: ", too_big = "Kod çok büyük (en fazla 200000 karakter).",
    pub_ok = "Yayınlandı! Script ID: ", pub_fail = "Yayınlanamadı: ", copied = " (panoya kopyalandı)",
    daily = "Günde 1 script yayınlayabilirsin. Yaklaşık %d saat sonra tekrar dene.",
    write_fail = "Kod yazılamadı", id_full = "ID sınırına ulaşıldı.",
    retry_hint = " (Aynı kodla tekrar basarsan yine de yayınlanır.)",
  },
  en = {
    back = "← BACK", title = "Create Script", sub = "Publish your script; anyone can call it by ID",
    f_name = "Script name", f_image = "Image ID (rbxassetid)", f_desc = "Description", f_code = "Script code (Lua)",
    publish = "PUBLISH", publishing = "Publishing...",
    ld_pub = "PUBLISHING SCRIPT", ld_wait = "Please wait", ld_done = "Published, final checks...",
    bad_name = "Script name must be 3-40 characters.", bad_code = "Script code cannot be empty.",
    bad_syntax = "Syntax error in code: ", too_big = "Code is too large (max 200000 characters).",
    pub_ok = "Published! Script ID: ", pub_fail = "Could not publish: ", copied = " (copied to clipboard)",
    daily = "You can publish 1 script per day. Try again in about %d hour(s).",
    write_fail = "Could not write code", id_full = "ID limit reached.",
    retry_hint = " (Press again with the same code to publish anyway.)",
  },
}

local M = {}

function M.open(ctx)
  ctx = ctx or {}
  local core = loadCore()
  if not core then
    print("[create] hubcore yuklenemedi")
    if type(ctx.onBack) == "function" then ctx.onBack() end
    return
  end
  local lang = (ctx.lang == "en") and "en" or "tr"
  local function T(k) return STR[lang][k] or STR.tr[k] or k end
  local spawn, sleep = core.spawn, core.sleep
  local nick = core.currentNick(ctx)

  local u = core.ui(ctx, { name = "Create", title = T("title"), sub = T("sub"), back = true, backText = T("back") })
  if not u then return end
  local C = u.C
  local toast = u.toast

  local fName  = u.input(84, 40, T("f_name"), false)
  local fImage = u.input(132, 40, T("f_image"), false)
  local fDesc  = u.input(180, 40, T("f_desc"), false)
  local fCode  = u.input(228, 200, T("f_code"), true)
  local pubBtn = u.pill(T("publish"), u.PAD, 442, u.IW, 48, true)
  pubBtn.TextSize = 14

  -- Yayın: kod dosyasını ID'li yaz + index'e kaydı ekle (çakışmaya dayanıklı)
  local function publishScript(d)
    local wroteId = nil
    return core.mutateIndex(function(idx, h)
      if not wroteId then
        local left = core.dailyLeft(d.ownerNick, idx)
        if left > 0 then return false, string.format(T("daily"), math.ceil(left / 3600)) end

        local id = math.max(1, math.floor(tonumber(idx.next) or 1))
        for _, e in ipairs(idx.scripts) do
          local eid = tonumber(e.id) or 0
          if eid >= id then id = eid + 1 end
        end
        local wrote, conflicts, lastMsg, n = false, 0, "", 0
        while n < 8 do
          n = n + 1
          if id > core.MAX_ID then return false, T("id_full") end
          local name9 = core.pad(id)
          local cw, bw = core.req(core.API .. name9, "PUT", core.jsonEncode({
            message = "hub: script " .. name9, content = core.b64encode(d.code), branch = core.BRANCH,
          }), h)
          if not cw then return false, core.netErr(lang, bw) end
          if cw == 200 or cw == 201 then wrote = true break end
          if cw == 401 or cw == 403 then return false, core.E(lang, "bad_key"), true end
          if cw == 404 then return false, core.E(lang, "no_repo"), true end
          if cw == 409 and conflicts < 3 then
            conflicts = conflicts + 1
            n = n - 1
            sleep(1)
          elseif cw == 422 then
            lastMsg = core.ghMsg(bw)
            id = id + 1
          else
            return false, T("write_fail") .. " (HTTP " .. tostring(cw) .. ") " .. core.ghMsg(bw)
          end
        end
        if not wrote then
          return false, T("write_fail") .. (lastMsg ~= "" and (" [" .. lastMsg .. "]") or "")
        end
        wroteId = id
      end

      local exists = false
      for _, e in ipairs(idx.scripts) do
        if tonumber(e.id) == wroteId then exists = true break end
      end
      if not exists then
        idx.scripts[#idx.scripts + 1] = {
          id = wroteId, name = d.name, author = d.author, owner = d.owner, ownerNick = d.ownerNick,
          desc = d.desc, image = d.image or 0,
          rating = 0, good = 0, bad = 0, uses = 0, created = os.time(),
        }
      end
      idx.next = math.max(math.floor(tonumber(idx.next) or 1), wroteId + 1)
      return true, core.pad(wroteId)
    end, lang)
  end

  local publishing, lastBad = false, nil
  pubBtn.MouseButton1Click:Connect(function()
    if publishing then return end
    local name = core.cleanText(core.trim(fName.Text), 40)
    local desc = core.cleanText(core.trim(fDesc.Text), 200)
    local code = core.cleanCode(fCode.Text)
    local nameLen = core.ulen(name)
    if nameLen < 3 or nameLen > 40 then toast(T("bad_name"), C.danger) return end
    if core.trim(code) == "" then toast(T("bad_code"), C.danger) return end
    if #code > 200000 then toast(T("too_big"), C.danger) return end

    if type(loadstring) == "function" and code ~= lastBad then
      local fn, err = loadstring(code)
      if not fn then
        local fixed = core.fixQuotes(code)
        if fixed ~= code and loadstring(fixed) then
          code = fixed
        else
          lastBad = code
          toast(T("bad_syntax") .. core.shortErr(err) .. T("retry_hint"), C.danger, 8)
          return
        end
      end
    end

    local imgId = tonumber(core.trim(fImage.Text):match("%d+") or "")
    local uid = core.userId()
    local nickClean = core.cleanText(nick, 30)
    local data = {
      name = name, desc = desc, code = code, author = nickClean, ownerNick = nickClean,
      image = imgId, owner = uid,
    }
    publishing = true
    pubBtn.Text = T("publishing")

    spawn(function()
      -- günlük hak önce kontrol edilir: hak yoksa beklemeye girilmez
      local left = core.dailyLeft(nickClean, core.readIndex())
      if left > 0 then
        publishing = false
        if u.alive() then
          pubBtn.Text = T("publish")
          toast(string.format(T("daily"), math.ceil(left / 3600)), C.danger, 8)
        end
        return
      end

      u.loading(true, T("ld_pub"), T("ld_wait"), true)
      local box = { done = false }
      spawn(function()
        local okRun, ok, res = pcall(publishScript, data)
        if not okRun then ok, res = false, "Hata: " .. core.shortErr(ok) end
        box.ok, box.res, box.done = ok, res, true
      end)

      local t0 = os.clock()
      while u.alive() do
        local el = os.clock() - t0
        local remain = math.max(0, WAIT - el)
        if box.done and not box.ok then break end   -- hata: beklemeye gerek yok
        if box.done and remain <= 0 then break end
        u.loadingInfo(T("ld_wait") .. "  " .. string.format("%d", math.ceil(remain)) .. "s", el / WAIT)
        sleep(0.2)
      end

      publishing = false
      if not u.alive() then return end
      u.loading(false)
      pubBtn.Text = T("publish")

      if box.ok then
        local msg = T("pub_ok") .. tostring(box.res)
        if type(setclipboard) == "function" then
          if pcall(setclipboard, tostring(box.res)) then msg = msg .. T("copied") end
        end
        toast(msg, C.ok, 7)
        core.safe(function() fName.Text, fImage.Text, fDesc.Text, fCode.Text = "", "", "", "" end)
        lastBad = nil
      else
        toast(T("pub_fail") .. tostring(box.res), C.danger, 10)
      end
    end)
  end)

  u.backBtn.MouseButton1Click:Connect(function()
    if publishing then return end
    local back = ctx.onBack
    u.close()
    if type(back) == "function" then back() end
  end)
end

return M
