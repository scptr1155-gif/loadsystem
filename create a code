-- create a code | SCRIPT OLUŞTURMA VE YAYINLAMA (v1.0)
-- =========================================================
-- main-menu'deki CREATE düğmesi bu dosyayı indirip çalıştırır.
--
-- Döndürdüğü tablo:
-- publish({name, image, desc, code, author, apiKey}) -> ok:boolean, idVeyaMesaj
--
-- Ne yapar:
-- 1. hub/index.json dosyasını GitHub API ile okur (yoksa boş başlar).
-- 2. Sıradaki ID'yi alır (1, 2, 3 ...).
-- 3. Kodu hub/<ID>.lua olarak yazar.
-- 4. Yeni kaydı hub/index.json'a ekler.
-- `scripthub` dosyası bu verileri okuyup hub'da gösterir.
--
-- API anahtarı: main-menu içindeki CONFIG.API_KEY (S.API_KEY). Boşsa yayınlama
-- "API anahtarı ayarlanmadı" hatası verir. Anahtar GitHub token'ıdır ve
-- repoya "Contents: read & write" yetkisi olmalıdır.
-- UYARI: Anahtarı dosyaya düz yazarsan scripti çalıştıran herkes görebilir.
-- Gerçek dünya yayını için sonra bir sunucu/API arkasına alınmalı.

local G = (type(getgenv) == "function" and getgenv()) or _G
local S = G.__LOADSYS or {}

local OWNER, REPO, BRANCH = "scptr1155-gif", "loadsystem", "main"
local API = "https://api.github.com/repos/" .. OWNER .. "/" .. REPO .. "/contents/"
local HttpService = game:GetService("HttpService")

--------------------------------------------------------------
-- Base64
--------------------------------------------------------------
local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local B64MAP = {}
for i = 1, #B64 do B64MAP[B64:sub(i, i)] = i - 1 end

local function b64encode(data)
  local out = {}
  for i = 1, #data, 3 do
    local b1, b2, b3 = data:byte(i, i + 2)
    local v = (b1 or 0) * 65536 + (b2 or 0) * 256 + (b3 or 0)
    local c1 = math.floor(v / 262144) % 64
    local c2 = math.floor(v / 4096) % 64
    local c3 = math.floor(v / 64) % 64
    local c4 = v % 64
    out[#out + 1] = B64:sub(c1 + 1, c1 + 1) .. B64:sub(c2 + 1, c2 + 1)
    out[#out + 1] = (b2 and B64:sub(c3 + 1, c3 + 1)) or "="
    out[#out + 1] = (b3 and B64:sub(c4 + 1, c4 + 1)) or "="
  end
  return table.concat(out)
end

local function b64decode(data)
  data = data:gsub("%s+", "")
  local out, buf, bits = {}, 0, 0
  for i = 1, #data do
    local v = B64MAP[data:sub(i, i)]
    if v then
      buf = buf * 64 + v
      bits = bits + 6
      if bits >= 8 then
        bits = bits - 8
        out[#out + 1] = string.char(math.floor(buf / (2 ^ bits)) % 256)
        buf = buf % (2 ^ bits)
      end
    end
  end
  return table.concat(out)
end

--------------------------------------------------------------
-- HTTP (executor request fonksiyonu gerekir: başlık gönderebilmek için)
--------------------------------------------------------------
local function req(url, method, body, headers)
  local fn
  if type(request) == "function" then fn = request
  elseif type(http_request) == "function" then fn = http_request
  elseif type(syn) == "table" and type(syn.request) == "function" then fn = syn.request end
  if not fn then return nil, "executor request desteklemiyor" end
  local ok, res = pcall(fn, { Url = url, Method = method, Headers = headers, Body = body })
  if not ok or type(res) ~= "table" then return nil, tostring(res) end
  return tonumber(res.StatusCode or res.Status) or 0, tostring(res.Body or "")
end

local function decode(s)
  local ok, d = pcall(function() return HttpService:JSONDecode(s) end)
  if ok then return d end
  return nil
end

local function trim(s) return ((tostring(s or "")):match("^%s*(.-)%s*$")) end

--------------------------------------------------------------
-- Yayınla
--------------------------------------------------------------
local M = {}

function M.publish(d)
  if type(d) ~= "table" then return false, "gecersiz veri" end
  local key = trim(d.apiKey or S.API_KEY)
  if key == "" then return false, "API anahtari ayarlanmadi" end

  local name = trim(d.name):gsub("[%c]", " ")
  local desc = trim(d.desc):gsub("[%c]", " ")
  local author = trim(d.author):gsub("[%c]", " ")
  local code = tostring(d.code or "")
  if #name < 3 or #name > 40 then return false, "script adi 3-40 karakter olmali" end
  if trim(code) == "" then return false, "kod bos" end
  if #code > 200000 then return false, "kod cok buyuk (en fazla 200000 karakter)" end
  if #desc > 200 then desc = desc:sub(1, 200) end
  local image = tonumber(d.image)

  local h = {
    ["Accept"] = "application/vnd.github+json",
    ["X-GitHub-Api-Version"] = "2022-11-28",
    ["User-Agent"] = "loadsystem-lua",
    ["Authorization"] = "Bearer " .. key,
    ["Content-Type"] = "application/json",
  }

  for _ = 1, 3 do
    -- 1) index oku
    local code1, body1 = req(API .. "hub/index.json?ref=" .. BRANCH .. "&t=" .. tostring(os.time()), "GET", nil, h)
    if not code1 then return false, tostring(body1) end
    local idx, sha = { next = 1, scripts = {} }, nil
    if code1 == 200 then
      local j = decode(body1)
      if type(j) ~= "table" or not j.sha or type(j.content) ~= "string" then return false, "index okunamadi" end
      sha = j.sha
      local parsed = decode(b64decode(j.content))
      if type(parsed) == "table" and type(parsed.scripts) == "table" then idx = parsed end
    elseif code1 == 401 or code1 == 403 then
      return false, "API anahtari gecersiz veya yetkisiz (HTTP " .. code1 .. ")"
    elseif code1 ~= 404 then
      return false, "index okunamadi (HTTP " .. tostring(code1) .. ")"
    end

    -- 2) sıradaki ID
    local id = math.max(1, math.floor(tonumber(idx.next) or 1))
    for _, e in ipairs(idx.scripts) do
      local eid = tonumber(e.id) or 0
      if eid >= id then id = eid + 1 end
    end

    -- 3) kodu yaz (aynı ID'li dosya varsa bir sonraki ID'yi dene)
    local wrote = false
    for _ = 1, 5 do
      local cw, bw = req(API .. "hub/" .. tostring(id) .. ".lua", "PUT", HttpService:JSONEncode({
        message = "hub: script #" .. tostring(id),
        content = b64encode(code),
        branch = BRANCH,
      }), h)
      if not cw then return false, tostring(bw) end
      if cw == 200 or cw == 201 then wrote = true break end
      if cw == 422 then id = id + 1
      else return false, "kod yazilamadi (HTTP " .. tostring(cw) .. ")" end
    end
    if not wrote then return false, "bos ID bulunamadi" end

    -- 4) index güncelle
    idx.scripts[#idx.scripts + 1] = {
      id = id, name = name, author = author, desc = desc, image = image or 0,
      rating = 0, uses = 0, created = os.time(),
    }
    idx.next = id + 1
    local payload = { message = "hub: index (#" .. tostring(id) .. ")", content = b64encode(HttpService:JSONEncode(idx)), branch = BRANCH }
    if sha then payload.sha = sha end
    local ci, bi = req(API .. "hub/index.json", "PUT", HttpService:JSONEncode(payload), h)
    if not ci then return false, tostring(bi) end
    if ci == 200 or ci == 201 then return true, id end
    if ci ~= 409 and ci ~= 422 then return false, "index yazilamadi (HTTP " .. tostring(ci) .. ")" end
    -- cakisma: baskasi ayni anda yayinladi, bastan dene
  end
  return false, "cakisma, tekrar dene"
end

return M
