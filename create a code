-- Yayınlama
-- Dönüş: ok, idVeyaMesaj, yetkiHatasi (true ise sıradaki anahtar denenir)
--------------------------------------------------------------
local function publishWith(key, d, T)
  local h = {
    ["Accept"] = "application/vnd.github+json",
    ["X-GitHub-Api-Version"] = "2022-11-28",
    ["User-Agent"] = "loadsystem-lua",
    ["Authorization"] = "Bearer " .. key,
    ["Content-Type"] = "application/json",
  }

  local wroteId = nil -- kod dosyası yazıldıysa ID'si (çakışmada yeniden yazılmaz)

  for _ = 1, 4 do
    -- 1) index'i oku
    local c1, b1 = req(API .. INDEX_FILE .. "?ref=" .. BRANCH .. "&t=" .. tostring(os.time()), "GET", nil, h)
    if not c1 then
      if b1 == "no_req" then return false, T("no_req") end
      return false, T("net_fail") .. " (" .. tostring(b1):sub(1, 60) .. ")"
    end

    local idx, sha = { next = 1, scripts = {} }, nil
    if c1 == 200 then
      local j = jsonDecode(b1)
      if type(j) ~= "table" or not j.sha then return false, T("idx_fail") end
      sha = j.sha
      local raw = b64decode(tostring(j.content or ""))
      if trim(raw) ~= "" then
        local p = jsonDecode(raw)
        if type(p) ~= "table" then return false, T("idx_bad") end
        if p.scripts == nil then p.scripts = {} end
        if type(p.scripts) ~= "table" then return false, T("idx_bad") end
        idx = p
      end
    elseif c1 == 401 or c1 == 403 then
      return false, T("bad_key") .. " [" .. ghMsg(b1) .. "]", true
    elseif c1 == 404 then
      -- index dosyası mı yok, yoksa depo/yetki mi yok?
      local cr = req(REPO_API, "GET", nil, h)
      if cr == 404 then return false, T("no_repo"), true end
      if cr == 401 or cr == 403 then return false, T("bad_key"), true end
    else
      return false, T("idx_fail") .. " (HTTP " .. tostring(c1) .. ")"
    end

    -- 2) kodu ID'li dosya olarak yaz (sadece bir kez)
    if not wroteId then
      local id = math.max(1, math.floor(tonumber(idx.next) or 1))
      for _, e in ipairs(idx.scripts) do
        local eid = tonumber(e.id) or 0
        if eid >= id then id = eid + 1 end
      end

      local wrote = false
      local conflicts = 0
      local lastMsg = ""
      local n = 0
      while n < 8 do
        n = n + 1
        if id > MAX_ID then return false, T("id_full") end
        local name9 = string.format("%09d", id)
        local cw, bw = req(API .. name9, "PUT", jsonEncode({
          message = "hub: script " .. name9, content = b64encode(d.code), branch = BRANCH,
        }), h)
        if not cw then return false, T("net_fail") .. " (" .. tostring(bw):sub(1, 60) .. ")" end
        if cw == 200 or cw == 201 then
          wrote = true
          break
        end
        if cw == 401 or cw == 403 then return false, T("bad_key") .. " [" .. ghMsg(bw) .. "]", true end
        if cw == 404 then return false, T("no_repo"), true end
        if cw == 409 and conflicts < 3 then
          -- aynı anda başka yazım oldu: aynı ID ile kısa beklemeyle tekrar dene
          conflicts = conflicts + 1
          n = n - 1
          sleep(1)
        elseif cw == 422 then
          lastMsg = ghMsg(bw)
          id = id + 1 -- bu ID dolu, sıradakini dene
        else
          return false, T("write_fail") .. " (HTTP " .. tostring(cw) .. ") " .. ghMsg(bw)
        end
      end
      if not wrote then
        local extra = ""
        if lastMsg ~= "" then extra = " [" .. lastMsg .. "]" end
        return false, T("write_fail") .. extra
      end
      wroteId = id
    end

    -- 3) index'e kaydı ekle
    local id = wroteId
    local exists = false
    for _, e in ipairs(idx.scripts) do
      if tonumber(e.id) == id then
        exists = true
        break
      end
    end
    if not exists then
      idx.scripts[#idx.scripts + 1] = {
        id = id, name = d.name, author = d.author, desc = d.desc, image = d.image or 0,
        rating = 0, uses = 0, created = os.time(),
      }
    end
    idx.next = math.max(math.floor(tonumber(idx.next) or 1), id + 1)

    local payload = {
      message = "hub: index (" .. string.format("%09d", id) .. ")",
      content = b64encode(jsonEncode(idx)), branch = BRANCH,
    }
    if sha then payload.sha = sha end
    local ci, bi = req(API .. INDEX_FILE, "PUT", jsonEncode(payload), h)
    if not ci then return false, T("net_fail") .. " (" .. tostring(bi):sub(1, 60) .. ")" end
    if ci == 200 or ci == 201 then return true, string.format("%09d", id) end
    if ci == 401 or ci == 403 then
      return false, T("idx_write_fail") .. string.format("%09d", id) .. " [" .. ghMsg(bi) .. "]", true
    end
    if ci ~= 409 and ci ~= 422 then
      return false, T("idx_write_fail") .. string.format("%09d", id) .. " (HTTP " .. tostring(ci) .. ")"
    end
    -- 409/422: başkası aynı anda yayınladı; index'i tekrar okuyup dene (kod dosyası korunur)
    sleep(0.5)
  end
  return false, T("conflict")
end

