-- Metin temizleme (UTF-8 güvenli)
--------------------------------------------------------------
local function ulen(s)
  s = tostring(s or "")
  if type(utf8) == "table" and type(utf8.len) == "function" then
    local ok, n = pcall(utf8.len, s)
    if ok and n then return n end
  end
  return #s
end

-- kontrol karakterlerini temizler, geçersiz UTF-8'i atar, karakter sınırında keser
local function cleanText(s, maxChars)
  s = tostring(s or "")
  s = s:gsub("%c", " ")
  if type(utf8) == "table" and type(utf8.len) == "function" then
    local ok, n = pcall(utf8.len, s)
    if not ok or not n then
      s = s:gsub("[\128-\255]", "?")
    end
    if maxChars and ulen(s) > maxChars then
      local okO, cut = pcall(utf8.offset, s, maxChars + 1)
      if okO and cut then s = s:sub(1, cut - 1) end
    end
  elseif maxChars and #s > maxChars then
    s = s:sub(1, maxChars)
  end
  return s
end

local function trim(s) return ((tostring(s or "")):match("^%s*(.-)%s*$")) end

-- Görünmez karakterleri (BOM, sıfır genişlikli boşluk, nbsp) temizle
local function cleanCode(s)
  s = tostring(s or "")
  s = s:gsub("\239\187\191", "")
  s = s:gsub("\226\128[\139-\141]", "")
  s = s:gsub("\226\129\160", "")
  s = s:gsub("\194\160", " ")
  s = s:gsub("\r\n?", "\n")
  return s
end

-- Telefon klavyesinin kıvrık tırnaklarını düz tırnağa çevir
local function fixQuotes(s)
  s = s:gsub("\226\128[\156\157]", '"')
  s = s:gsub("\226\128[\152\153]", "'")
  return s
end

local function shortErr(e)
  e = tostring(e)
  e = e:gsub('^%[string ".-"%]:', "satir ")
  return e:sub(1, 90)
end

