-- create a code | SCRIPT OLUŞTUR VE YAYINLA (v2.0)
-- =========================================================
-- scripthub'daki CREATE tuşu bu dosyayı indirir ve open(ctx) çağırır.
-- Form: script adı, resim ID, açıklama, kod. YAYINLA tuşu:
--   1. API anahtarını loadsystem deposundaki `api-key` dosyasından okur.
--   2. roblox-game-star deposunda hub-index.json'u okur, sıradaki ID'yi alır
--      (000000001 ... 999999999).
--   3. Kodu o ID'li dosya olarak yazar (örn. 000000001) ve index'e kaydı ekler.
--   (main-file dosyasına dokunulmaz.)
--
-- api-key dosyası biçimi (her satır bir anahtar, # ile başlayan satırlar yok sayılır):
--   ghp_xxx...            düz anahtar
--   rev:<ters yazılmış>   anahtarın ters çevrilmiş hali
--   b64:<base64>          anahtarın base64 hali
-- Not: GitHub, herkese açık depoda düz duran anahtarı otomatik iptal edebilir.
--      Bu yüzden rev: veya b64: kullanmanı öneririm (bu gizlilik değil, sadece
--      otomatik taramayı atlatır; dosyayı okuyan herkes anahtarı çözebilir).
--
-- ctx: { lang, accent, bg, anim, nick, player, onBack }

local G = (type(getgenv) == "function" and getgenv()) or _G
local S = G.__LOADSYS or {}
G.__LOADSYS = S

local BASE = "https://raw.githubusercontent.com/scptr1155-gif/loadsystem/refs/heads/main/"
local KEY_URL = BASE .. "api-key"
local OWNER, REPO, BRANCH = "scptr1155-gif", "roblox-game-star", "main"
local API = "https://api.github.com/repos/" .. OWNER .. "/" .. REPO .. "/contents/"
local INDEX_FILE = "hub-index.json"
local MAX_ID = 999999999

local function getService(n)
  local ok, s = pcall(function() return game:GetService(n) end)
  if ok and s then return s end
  return nil
end
local Players, TweenService, CoreGui = getService("Players"), getService("TweenService"), getService("CoreGui")
local HttpService, Workspace = getService("HttpService"), getService("Workspace")

local function spawn(fn, ...)
  if type(task) == "table" and type(task.spawn) == "function" then return task.spawn(fn, ...) end
  local co = coroutine.create(fn)
  coroutine.resume(co, ...)
  return co
end
local function delay(t, fn)
  if type(task) == "table" and type(task.delay) == "function" then return task.delay(t, fn) end
  spawn(function()
    if type(wait) == "function" then wait(t) end
    fn()
  end)
end
local function safe(fn, ...)
  local ok, a = pcall(fn, ...)
  return ok, a
end

