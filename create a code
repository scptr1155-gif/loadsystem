local C = {
  bg = Color3.fromRGB(9, 10, 14), bgTop = Color3.fromRGB(19, 21, 31), panel = Color3.fromRGB(13, 15, 20),
  card = Color3.fromRGB(22, 25, 33), cardHi = Color3.fromRGB(31, 35, 46), line = Color3.fromRGB(38, 42, 53),
  text = Color3.fromRGB(240, 242, 247), muted = Color3.fromRGB(144, 149, 165), faint = Color3.fromRGB(98, 103, 120),
  ok = Color3.fromRGB(34, 197, 94), danger = Color3.fromRGB(239, 68, 68), white = Color3.fromRGB(255, 255, 255),
}
local FNT = { reg = Enum.Font.Gotham, med = Enum.Font.GothamMedium, bold = Enum.Font.GothamBold }
local AL = Enum.TextXAlignment.Left

local function new(class, props, parent)
  local ok, o = pcall(function() return Instance.new(class) end)
  if not ok or not o then return nil end
  if props then for k, v in pairs(props) do safe(function() o[k] = v end) end end
  if parent then safe(function() o.Parent = parent end) end
  return o
end
local function round(o, r) if o then new("UICorner", { CornerRadius = UDim.new(0, r or 12) }, o) end end
local function stroke(o, col) if o then new("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = col, Thickness = 1 }, o) end end

local M = {}

function M.open(ctx)
  ctx = ctx or {}
  local lang = (ctx.lang == "en") and "en" or "tr"
  local function T(k) return STR[lang][k] or STR.tr[k] or k end
  local accent = ctx.accent or Color3.fromRGB(88, 101, 242)
  local accentHi = accent:Lerp(Color3.new(1, 1, 1), 0.18)
  local animOn = ctx.anim ~= false
  local nick = tostring(ctx.nick or "Player")

  safe(function() if S.CREATE_GUI then S.CREATE_GUI:Destroy() end end)
  local gui = new("ScreenGui", {
    Name = "LoadSystemCreate", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 800,
    ZIndex = 1, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
  })
  if not gui then return end
  local attached = false
  if CoreGui then attached = pcall(function() gui.Parent = CoreGui end) and gui.Parent == CoreGui end
  if not attached then pcall(function() gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui") end) end
  S.CREATE_GUI = gui

  local alive, publishing = true, false
  local function tw(obj, goal, t)
    if not obj then return end
    if animOn and TweenService then
      local ok = pcall(function()
        TweenService:Create(obj, TweenInfo.new(t or 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play()
      end)
      if ok then return end
    end
    for k, v in pairs(goal) do safe(function() obj[k] = v end) end
  end
  local function label(parent, text, x, y, w, h, size, font, color, extra)
    local p = {
      Size = UDim2.fromOffset(w, h), Position = UDim2.fromOffset(x, y), BackgroundTransparency = 1, Text = text,
      TextColor3 = color, TextSize = size, Font = font, TextXAlignment = AL, ZIndex = 4,
    }
    if extra then for k, v in pairs(extra) do p[k] = v end end
    return new("TextLabel", p, parent)
  end

  local bg = new("Frame", {
    Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.bg, BackgroundTransparency = (ctx.bg == false) and 0 or 1,
    BorderSizePixel = 0, ZIndex = 0,
  }, gui)
  new("UIGradient", { Color = ColorSequence.new(C.bgTop, C.bg), Rotation = 150 }, bg)

  local WIN_W, WIN_H, PAD = 880, 520, 28
  local IW = WIN_W - PAD * 2
  local window = new("Frame", {
    Size = UDim2.fromOffset(WIN_W, WIN_H), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
    BackgroundColor3 = C.panel, BorderSizePixel = 0, ZIndex = 2,
  }, bg)
  round(window, 18)
  stroke(window, C.line)
  local uiScale = new("UIScale", { Scale = 1 }, window)
  local function fit()
    local vp = Vector2.new(1280, 720)
    safe(function() local cam = Workspace.CurrentCamera if cam then vp = cam.ViewportSize end end)
    local s = math.min((vp.X - 24) / WIN_W, (vp.Y - 24) / WIN_H, 1)
    if s <= 0 then s = 1 end
    safe(function() uiScale.Scale = math.max(0.35, s) end)
  end
  fit()
  local camConn
  safe(function() camConn = Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit) end)

  local function close()
    alive = false
    safe(function() if camConn then camConn:Disconnect() end end)
    safe(function() gui:Destroy() end)
    if S.CREATE_GUI == gui then S.CREATE_GUI = nil end
  end

  -- Bildirim
  local toastF = new("Frame", {
    Size = UDim2.fromOffset(560, 42), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 70),
    BackgroundColor3 = C.cardHi, BorderSizePixel = 0, Visible = false, ZIndex = 60,
  }, window)
  round(toastF, 21)
  stroke(toastF, C.line)
  local toastDot = new("Frame", {
    Size = UDim2.fromOffset(8, 8), Position = UDim2.fromOffset(18, 17), BackgroundColor3 = C.muted, BorderSizePixel = 0, ZIndex = 61,
  }, toastF)
  round(toastDot, 4)
  local toastT = label(toastF, "", 36, 0, 512, 42, 12, FNT.med, C.text, { ZIndex = 61, TextTruncate = Enum.TextTruncate.AtEnd })
  local toastTok = 0
  local function toast(text, color)
    toastTok = toastTok + 1
    local my = toastTok
    safe(function()
      toastT.Text = tostring(text or "")
      toastDot.BackgroundColor3 = color or C.muted
      toastF.Visible = true
    end)
    tw(toastF, { Position = UDim2.new(0.5, 0, 1, -18) }, 0.3)
    delay(4, function()
      if my ~= toastTok or not alive then return end
      tw(toastF, { Position = UDim2.new(0.5, 0, 1, 70) }, 0.3)
    end)
  end

  -- Başlık + GERİ (hub'a döner)
  local backBtn = new("TextButton", {
    Size = UDim2.fromOffset(110, 38), Position = UDim2.fromOffset(PAD, 24), BackgroundColor3 = C.card, BorderSizePixel = 0,
    Text = T("back"), TextColor3 = C.text, TextSize = 12, Font = FNT.bold, AutoButtonColor = false, ZIndex = 4,
  }, window)
  round(backBtn, 10)
  stroke(backBtn, C.line)
  backBtn.MouseEnter:Connect(function() tw(backBtn, { BackgroundColor3 = C.cardHi }, 0.12) end)
  backBtn.MouseLeave:Connect(function() tw(backBtn, { BackgroundColor3 = C.card }, 0.12) end)
  label(window, T("title"), PAD + 126, 20, 400, 28, 22, FNT.bold, C.text)
  label(window, T("sub"), PAD + 126, 48, 500, 16, 12, FNT.reg, C.muted)

  local function inputBox(y, h, placeholder, multi)
    local f = new("Frame", {
      Size = UDim2.fromOffset(IW, h), Position = UDim2.fromOffset(PAD, y), BackgroundColor3 = C.card, BorderSizePixel = 0, ZIndex = 3,
    }, window)
    round(f, 10)
    stroke(f, C.line)
    return new("TextBox", {
      Size = UDim2.new(1, -24, 1, -(multi and 16 or 0)), Position = UDim2.fromOffset(12, multi and 8 or 0),
      BackgroundTransparency = 1, Text = "", PlaceholderText = placeholder, PlaceholderColor3 = C.faint,
      TextColor3 = C.text, TextSize = 13, Font = FNT.reg, ClearTextOnFocus = false, MultiLine = multi and true or false,
      TextWrapped = multi and true or false, TextXAlignment = AL,
      TextYAlignment = multi and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center, ZIndex = 4,
    }, f)
  end
  local fName  = inputBox(84, 40, T("f_name"), false)
  local fImage = inputBox(132, 40, T("f_image"), false)
  local fDesc  = inputBox(180, 40, T("f_desc"), false)
  local fCode  = inputBox(228, 200, T("f_code"), true)

  local pubBtn = new("TextButton", {
    Size = UDim2.fromOffset(IW, 48), Position = UDim2.fromOffset(PAD, 442), BackgroundColor3 = accent, BorderSizePixel = 0,
    Text = T("publish"), TextColor3 = C.white, TextSize = 14, Font = FNT.bold, AutoButtonColor = false, ZIndex = 4,
  }, window)
  round(pubBtn, 12)
  pubBtn.MouseEnter:Connect(function() tw(pubBtn, { BackgroundColor3 = accentHi }, 0.12) end)
  pubBtn.MouseLeave:Connect(function() tw(pubBtn, { BackgroundColor3 = accent }, 0.12) end)

  pubBtn.MouseButton1Click:Connect(function()
    if publishing then return end
    local name = trim(fName.Text):gsub("%c", " ")
    local desc = trim(fDesc.Text):gsub("%c", " ")
    local code = fCode.Text or ""
    if #name < 3 or #name > 40 then toast(T("bad_name"), C.danger) return end
    if trim(code) == "" then toast(T("bad_code"), C.danger) return end
    if #code > 200000 then toast(T("too_big"), C.danger) return end
    if #desc > 200 then desc = desc:sub(1, 200) end
    if type(loadstring) == "function" then
      local fn, err = loadstring(code)
      if not fn then toast(T("bad_syntax") .. tostring(err), C.danger) return end
    end
    local data = { name = name, desc = desc, code = code, author = nick, image = tonumber(trim(fImage.Text)) }
    publishing = true
    safe(function() pubBtn.Text = T("publishing") end)
    spawn(function()
      local keys = readKeys()
      local ok, res = false, T("no_key")
      for _, k in ipairs(keys) do
        local o, r, authFail = publishWith(k, data, T)
        ok, res = o, r
        if o or not authFail then break end
      end
      publishing = false
      if not alive then return end
      safe(function() pubBtn.Text = T("publish") end)
      if ok then
        toast(T("pub_ok") .. tostring(res), C.ok)
        safe(function() fName.Text, fImage.Text, fDesc.Text, fCode.Text = "", "", "", "" end)
      else
        toast(T("pub_fail") .. tostring(res), C.danger)
      end
    end)
  end)

  backBtn.MouseButton1Click:Connect(function()
    if publishing then return end
    local back = ctx.onBack
    close()
    if type(back) == "function" then back() end
  end)
end

return M
