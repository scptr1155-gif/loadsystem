-- API anahtarı (loadsystem/api-key) + GitHub API
--------------------------------------------------------------
local function readKeys()
  local ok, src = pcall(function() return game:HttpGet(KEY_URL .. "?t=" .. tostring(os.time())) end)
  if not ok or type(src) ~= "string" or src:sub(1, 14) == "404: Not Found" then return {} end
  local keys = {}
  for line in (src .. "\n"):gmatch("(.-)\n") do
    line = line:gsub("%s+", "")
    if line ~= "" and line:sub(1, 1) ~= "#" then
      if line:sub(1, 4) == "rev:" then line = line:sub(5):reverse()
      elseif line:sub(1, 4) == "b64:" then line = b64decode(line:sub(5)) end
      if line ~= "" then keys[#keys + 1] = line end
    end
  end
  return keys
end

local function req(url, method, body, headers)
  local fn
  if type(request) == "function" then fn = request
  elseif type(http_request) == "function" then fn = http_request
  elseif type(syn) == "table" and type(syn.request) == "function" then fn = syn.request end
  if not fn then return nil, "no_req" end
  local ok, res = pcall(fn, { Url = url, Method = method, Headers = headers, Body = body })
  if not ok or type(res) ~= "table" then return nil, tostring(res) end
  return tonumber(res.StatusCode or res.Status) or 0, tostring(res.Body or "")
end

local function decode(s)
  local ok, d = pcall(function() return HttpService:JSONDecode(s) end)
  if ok then return d end
  return nil
end

local function trim(s) return ((tostring(s or "")):match("^%s*(.-)%s*$")) end

-- Bir anahtarla yayınla. Dönüş: ok, idVeyaMesaj, yetkiHatasi
local function publishWith(key, d, T)
  local h = {
    ["Accept"] = "application/vnd.github+json",
    ["X-GitHub-Api-Version"] = "2022-11-28",
    ["User-Agent"] = "loadsystem-lua",
    ["Authorization"] = "Bearer " .. key,
    ["Content-Type"] = "application/json",
  }
  for _ = 1, 3 do
    local c1, b1 = req(API .. INDEX_FILE .. "?ref=" .. BRANCH .. "&t=" .. tostring(os.time()), "GET", nil, h)
    if not c1 then
      if b1 == "no_req" then return false, T("no_req") end
      return false, tostring(b1)
    end
    local idx, sha = { next = 1, scripts = {} }, nil
    if c1 == 200 then
      local j = decode(b1)
      if type(j) ~= "table" or not j.sha or type(j.content) ~= "string" then return false, T("idx_fail") end
      sha = j.sha
      local p = decode(b64decode(j.content))
      if type(p) == "table" and type(p.scripts) == "table" then idx = p end
    elseif c1 == 401 or c1 == 403 then
      return false, T("bad_key"), true
    elseif c1 ~= 404 then
      return false, T("idx_fail") .. " (HTTP " .. tostring(c1) .. ")"
    end

    local id = math.max(1, math.floor(tonumber(idx.next) or 1))
    for _, e in ipairs(idx.scripts) do
      local eid = tonumber(e.id) or 0
      if eid >= id then id = eid + 1 end
    end

    local wrote = false
    for _ = 1, 5 do
      if id > MAX_ID then return false, T("id_full") end
      local name9 = string.format("%09d", id)
      local cw, bw = req(API .. name9, "PUT", HttpService:JSONEncode({
        message = "hub: script " .. name9, content = b64encode(d.code), branch = BRANCH,
      }), h)
      if not cw then return false, tostring(bw) end
      if cw == 200 or cw == 201 then wrote = true break end
      if cw == 401 or cw == 403 then return false, T("bad_key"), true end
      if cw == 422 then id = id + 1
      else return false, T("write_fail") .. " (HTTP " .. tostring(cw) .. ")" end
    end
    if not wrote then return false, T("write_fail") end

    idx.scripts[#idx.scripts + 1] = {
      id = id, name = d.name, author = d.author, desc = d.desc, image = d.image or 0,
      rating = 0, uses = 0, created = os.time(),
    }
    idx.next = id + 1
    local payload = {
      message = "hub: index (" .. string.format("%09d", id) .. ")",
      content = b64encode(HttpService:JSONEncode(idx)), branch = BRANCH,
    }
    if sha then payload.sha = sha end
    local ci, bi = req(API .. INDEX_FILE, "PUT", HttpService:JSONEncode(payload), h)
    if not ci then return false, tostring(bi) end
    if ci == 200 or ci == 201 then return true, string.format("%09d", id) end
    if ci == 401 or ci == 403 then return false, T("bad_key"), true end
    if ci ~= 409 and ci ~= 422 then return false, T("idx_fail") .. " (HTTP " .. tostring(ci) .. ")" end
    -- çakışma: başkası aynı anda yayınladı, baştan dene
  end
  return false, T("conflict")
end

