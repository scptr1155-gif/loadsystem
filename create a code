yerel HttpService = oyun:GetService("HttpService")

--------------------------------------------------------------
-- Base64
--------------------------------------------------------------
yerel B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
yerel B64MAP = {}
for i = 1, #B64 do B64MAP[B64:sub(i, i)] = i - 1 end

yerel fonksiyon b64encode(veri)
  yerel çıktı = {}
  i = 1, #veri, 3 için
    yerel b1, b2, b3 = veri:byte(i, i + 2)
    yerel v = (b1 veya 0) * 65536 + (b2 veya 0) * 256 + (b3 veya 0)
    yerel c1 = math.floor(v / 262144) % 64
    yerel c2 = math.floor(v / 4096) % 64
    yerel c3 = math.floor(v / 64) % 64
    yerel c4 = v % 64
    out[#out + 1] = B64:sub(c1 + 1, c1 + 1) .. B64:sub(c2 + 1, c2 + 1)
    out[#out + 1] = (b2 ve B64:sub(c3 + 1, c3 + 1)) veya "="
    out[#out + 1] = (b3 ve B64:sub(c4 + 1, c4 + 1)) veya "="
  son
  tabloyu birleştirerek döndür
son

yerel fonksiyon b64decode(veri)
  veri = veri:gsub("%s+", "")
  yerel çıkış, tampon, bitler = {}, 0, 0
  i = 1 için #veri
    yerel v = B64MAP[veri:alt(i, i)]
    eğer v ise o zaman
      buf = buf * 64 + v
      bitler = bitler + 6
      eğer bit sayısı >= 8 ise
        bitler = bitler - 8
        out[#out + 1] = string.char(math.floor(buf / (2 ^ bits)) % 256)
        buf = buf % (2 ^ bit)
      son
    son
  son
  tabloyu birleştirerek döndür
son

--------------------------------------------------------------
-- HTTP (yürütücü istek fonksiyonu gerekir: başlık oluşturabilmek için)
--------------------------------------------------------------
yerel fonksiyon req(url, method, body, headers)
  yerel fn
  if type(request) == "function" then fn = request
  elseif type(http_request) == "function" then fn = http_request
  elseif type(syn) == "table" and type(syn.request) == "function" then fn = syn.request end
  Eğer fn değilse, nil döndür, "yürütücü isteği desteklenmiyor".
  yerel tamam, res = pcall(fn, { Url = url, Method = method, Headers = headers, Body = body })
  Eğer sorun yoksa veya type(res) ~= "table" ise nil döndür, tostring(res) işlemini sonlandır.
  return tonumber(res.StatusCode or res.Status) or 0, tostring(res.Body or "")
son

yerel fonksiyon kod çözme(ler)
  yerel tamam, d = pcall(function() return HttpService:JSONDecode(s) end)
  Eğer uygunsa, d'yi döndür.
  boş döndür
son

yerel fonksiyon trim(s) return ((tostring(s or "")):match("^%s*(.-)%s*$")) end

