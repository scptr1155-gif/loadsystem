local C = {
  bg        = Color3.fromRGB(255, 255, 255),
  text      = Color3.fromRGB(22, 24, 29),
  muted     = Color3.fromRGB(140, 145, 155),
  faint     = Color3.fromRGB(176, 181, 190),
  placeholder = Color3.fromRGB(163, 168, 178),
  field     = Color3.fromRGB(245, 246, 248),
  fieldLine = Color3.fromRGB(226, 228, 233),
  dark      = Color3.fromRGB(20, 22, 26),
  darkHi    = Color3.fromRGB(38, 42, 49),
  hover     = Color3.fromRGB(249, 250, 251),
  accent    = Color3.fromRGB(88, 101, 242),
  ok        = Color3.fromRGB(22, 158, 92),
  err       = Color3.fromRGB(212, 68, 68),
}

local PANEL_W, PANEL_H = 440, 620
local FX, FW = 50, 340 -- form kenar boşluğu / genişliği

