local function makeButton(parent, text, y, dark)
  local b = new("TextButton", {
    Size = UDim2.fromOffset(FW, 52),
    Position = UDim2.fromOffset(FX, y),
    BackgroundColor3 = dark and C.dark or C.bg,
    BorderSizePixel = 0,
    Text = text,
    TextColor3 = dark and C.bg or C.text,
    TextSize = 15,
    Font = Enum.Font.GothamBold,
    AutoButtonColor = false,
    ZIndex = 4,
  }, parent)
  round(b, 12)
  if not dark then stroke(b, C.fieldLine, 1) end

  b.MouseEnter:Connect(function()
    tw(b, { BackgroundColor3 = dark and C.darkHi or C.hover }, 0.15)
  end)
  b.MouseLeave:Connect(function()
    tw(b, { BackgroundColor3 = dark and C.dark or C.bg }, 0.15)
  end)
  return b
end

--------------------------------------------------------------
-- Görünüm geçişi için saydamlaştırılacak nesneleri topla
-- Sadece gerçekten saydamlığı olan özellikler alınır:
--   Text*        -> TextTransparency (+ arka planı varsa BackgroundTransparency)
--   Frame        -> BackgroundTransparency
--   UIStroke     -> Transparency
-- (UICorner vb. hiçbir saydamlık özelliği taşımaz, atlanır)
--------------------------------------------------------------
local function collectFade(view)
  local list = {}

  local function add(inst, prop)
    local ok, v = pcall(function() return inst[prop] end)
    if ok and type(v) == "number" and v < 1 then
      list[#list + 1] = { inst, prop, v }
    end
  end

  local function walk(node)
    local ok, kids = pcall(function() return node:GetChildren() end)
    if not ok or not kids then return end
    for _, c in ipairs(kids) do
      local cn = c.ClassName
      if cn == "TextLabel" or cn == "TextButton" or cn == "TextBox" then
        add(c, "TextTransparency")
        add(c, "BackgroundTransparency")
      elseif cn == "Frame" then
        add(c, "BackgroundTransparency")
      elseif cn == "UIStroke" then
        add(c, "Transparency")
      end
      walk(c)
    end
  end

  walk(view)
  return list
end

