-- M (modül)
--------------------------------------------------------------
local M = {}
M.version = "1.0.0"

--------------------------------------------------------------
-- Alan (textbox) üretici
--------------------------------------------------------------
local function makeField(parent, opts)
  local frame = new("Frame", {
    Size = UDim2.fromOffset(FW, 46),
    Position = UDim2.fromOffset(FX, opts.y or 0),
    BackgroundColor3 = C.field,
    BorderSizePixel = 0,
    ZIndex = 2,
  }, parent)
  round(frame, 12)
  stroke(frame, C.fieldLine, 1)

  local ph = new("TextLabel", {
    Size = UDim2.new(1, -24, 1, 0),
    Position = UDim2.fromOffset(12, 0),
    BackgroundTransparency = 1,
    Text = opts.placeholder or "",
    TextColor3 = C.placeholder,
    TextSize = 15,
    Font = Enum.Font.Gotham,
    TextXAlignment = Enum.TextXAlignment.Left,
    TextYAlignment = Enum.TextYAlignment.Center,
    ZIndex = 3,
  }, frame)

  local box = new("TextBox", {
    Size = UDim2.new(1, -24, 1, 0),
    Position = UDim2.fromOffset(12, 0),
    BackgroundTransparency = 1,
    BorderSizePixel = 0,
    Text = "",
    TextSize = 15,
    Font = Enum.Font.Gotham,
    TextColor3 = C.text,
    PlaceholderText = "",
    ClearTextOnFocus = false,
    TextXAlignment = Enum.TextXAlignment.Left,
    TextYAlignment = Enum.TextYAlignment.Center,
    ZIndex = 4,
  }, frame)

  local bullets = nil
  if opts.mask then
    box.TextTransparency = 1
    bullets = new("TextLabel", {
      Size = UDim2.new(1, -24, 1, 0),
      Position = UDim2.fromOffset(12, 0),
      BackgroundTransparency = 1,
      Text = "",
      TextColor3 = C.text,
      TextSize = 15,
      Font = Enum.Font.Gotham,
      TextXAlignment = Enum.TextXAlignment.Left,
      TextYAlignment = Enum.TextYAlignment.Center,
      ZIndex = 5,
    }, frame)
  end

  local function refresh()
    local txt = box.Text or ""
    if bullets then bullets.Text = string.rep(BULLET, utf8.len(txt) or #txt) end
    ph.Visible = (txt == "")
  end

  box:GetPropertyChangedSignal("Text"):Connect(refresh)
  refresh()

  if opts.value and opts.value ~= "" then
    box.Text = tostring(opts.value)
    refresh()
  end
  if opts.readOnly then
    box.TextEditable = false
    box.TextColor3 = C.muted
  end

  return { frame = frame, box = box, refresh = refresh }
end

--------------------------------------------------------------
-- Buton üretici
--------------------------------------------------------------
local function makeButton(parent, text, y, dark)
  local b = new("TextButton", {
    Size = UDim2.fromOffset(FW, 52),
    Position = UDim2.fromOffset(FX, y),
    BackgroundColor3 = dark and C.dark or C.bg,
    BorderSizePixel = 0,
    Text = text,
    TextColor3 = dark and C.bg or C.text,
    TextSize = 15,
    Font = Enum.Font.GothamBold,
    AutoButtonColor = false,
    ZIndex = 4,
  }, parent)
  round(b, 12)
  if not dark then stroke(b, C.fieldLine, 1) end

  b.MouseEnter:Connect(function()
    tw(b, { BackgroundColor3 = dark and C.darkHi or C.hover }, 0.15)
  end)
  b.MouseLeave:Connect(function()
    tw(b, { BackgroundColor3 = dark and C.dark or C.bg }, 0.15)
  end)
  return b
end

