--[[
  verify-gui  |  LOAD SYSTEM — ARAYÜZ MODÜLÜ
  =========================================================
  Bu dosya tek başına çalıştırılmaz. `verify` tarafından
  raw.githubusercontent üzerinden indirilip loadstring ile
  çalıştırılır ve dönen tablo (M) arayüz API'sini taşır.

  İçerik:
    * Beyaz ortam paneli (beyaz ekran)
    * LOGIN / CREATE ACCOUNT ana menüsü
    * Login formu (takma ad + şifre)
    * Create Account formu (isim otomatik dolu + takma ad + şifre)
    * Hata / başarı mesaj alanı, tüm geçiş animasyonları

  Dönen değer:
    M.build(opts) -> panel
      opts.username  = oyuncunun adı (otomatik doldurulur)
      opts.onLogin   = function(nickname, password) -> ok:boolean, msg:string
      opts.onRegister= function(name, nickname, password) -> ok:boolean, msg:string
]]

local G = (type(getgenv) == "function" and getgenv()) or _G
local S = G.__LOADSYS or {}
G.__LOADSYS = S

local Players        = game:GetService("Players")
local TweenService   = game:GetService("TweenService")
local CoreGui        = game:GetService("CoreGui")

--------------------------------------------------------------
-- Temel yardımcılar
--------------------------------------------------------------
local BULLET = string.char(226, 128, 162) -- •

local function sleep(s)
  s = s or 0
  if type(task) == "table" and type(task.wait) == "function" then task.wait(s)
  elseif type(wait) == "function" then wait(s) end
end

local function new(class, props, parent)
  local o = Instance.new(class)
  if props then for k, v in pairs(props) do o[k] = v end end
  if parent then o.Parent = parent end
  return o
end

local function round(obj, radius)
  new("UICorner", { CornerRadius = UDim.new(0, radius or 12) }, obj)
end

local function stroke(obj, color, thickness)
  new("UIStroke", {
    ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    Color = color,
    Thickness = thickness or 1,
  }, obj)
end

local function tw(obj, goal, time, delay)
  local ok, t = pcall(function()
    return TweenService:Create(
      obj,
      TweenInfo.new(time or 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, delay or 0),
      goal
    )
  end)
  if ok and t then pcall(function() t:Play() end) end
  return t
end

