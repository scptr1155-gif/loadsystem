local BULLET = string.char(226, 128, 162) -- •

local function sleep(s)
  s = s or 0
  if type(task) == "table" and type(task.wait) == "function" then task.wait(s)
  elseif type(wait) == "function" then wait(s) end
end

local function new(class, props, parent)
  local o = Instance.new(class)
  -- Tek yanlış özellik tüm paneli çökertmesin
  if props then
    for k, v in pairs(props) do
      pcall(function() o[k] = v end)
    end
  end
  if parent then pcall(function() o.Parent = parent end) end
  return o
end

local function round(obj, radius)
  new("UICorner", { CornerRadius = UDim.new(0, radius or 12) }, obj)
end

local function stroke(obj, color, thickness)
  new("UIStroke", {
    ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    Color = color,
    Thickness = thickness or 1,
  }, obj)
end

-- Tween çalışmazsa hedef değerleri anında uygula (UI asla gizli kalmaz)
local function applyGoal(obj, goal)
  if not obj or type(goal) ~= "table" then return end
  for k, v in pairs(goal) do
    pcall(function() obj[k] = v end)
  end
end

local function tw(obj, goal, time, delay)
  if not obj then return nil end
  if not TweenService then
    applyGoal(obj, goal)
    return nil
  end
  local ok, t = pcall(function()
    return TweenService:Create(
      obj,
      TweenInfo.new(time or 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, delay or 0),
      goal
    )
  end)
  if ok and t then
    local played = pcall(function() t:Play() end)
    if played then return t end
  end
  applyGoal(obj, goal)
  return nil
end

