-- Siyah yükleme ekranını animasyonla kaldır
--------------------------------------------------------------
function M.dismissBoot()
  local boot = S.boot
  if not boot or not boot.bg then return end
  if boot.dismissed then return end
  boot.dismissed = true
  if boot.setText then pcall(boot.setText, "HAZIR") end
  tw(boot.bg, { BackgroundTransparency = 1 }, 0.5)
  if boot.title then tw(boot.title, { TextTransparency = 1 }, 0.35) end
  if boot.sub then tw(boot.sub, { TextTransparency = 1 }, 0.35) end
  if boot.bar then tw(boot.bar, { BackgroundTransparency = 1 }, 0.3) end

  -- Perde her koşulda kalkmalıdır: hem task.delay hem sleep denenir
  local killed = false
  local function kill()
    if killed then return end
    killed = true
    pcall(function() boot.gui:Destroy() end)
  end
  pcall(function()
    if type(task) == "table" and type(task.delay) == "function" then
      task.delay(0.7, kill)
    end
  end)
  sleep(0.6)
  kill()
  boot.bg = nil
end

