--[[
  verify-gui  |  LOAD SYSTEM — ARAYÜZ MODÜLÜ (v1.1.0)
  =========================================================
  Bu dosya tek başına çalıştırılmaz. `verify` tarafından
  raw.githubusercontent üzerinden indirilip loadstring ile
  çalıştırılır ve dönen tablo (M) arayüz API'sini taşır.

  İçerik:
    * Beyaz ortam paneli (beyaz ekran)
    * LOGIN / CREATE ACCOUNT ana menüsü
    * Login formu (takma ad + şifre)
    * Create Account formu (isim otomatik dolu + takma ad + şifre)
    * Hata / başarı mesaj alanı, tüm geçiş animasyonları

  Dönen değer:
    M.build(opts) -> panel
      opts.username  = oyuncunun adı (otomatik doldurulur)
      opts.onLogin   = function(nickname, password) -> ok:boolean, msg:string
      opts.onRegister= function(name, nickname, password) -> ok:boolean, msg:string

  v1.1.0 düzeltmeleri:
    * Görünüm geçişi (fade) artık sadece geçerli özelliklere tween uygular.
      Eski sürüm UICorner/UIStroke'a BackgroundTransparency tween etmeye
      çalışıp hata veriyordu ve animasyon hep iptal oluyordu.
    * Başarılı girişten sonra tekrar tıklanınca ikinci kez yükleme tetiklenmesi
      engellendi (busy, başarıda açık kalır).
    * Gölge animasyonu yanlış yöne kayıyordu, düzeltildi.
    * \u{...} kaçış dizileri kaldırıldı (eski Lua 5.1 tabanlı executor'larda
      derleme hatası verir); metinler doğrudan UTF-8.
]]

local G = (type(getgenv) == "function" and getgenv()) or _G
local S = G.__LOADSYS or {}
G.__LOADSYS = S

local function getService(name)
  local ok, s = pcall(function() return game:GetService(name) end)
  if ok and s then return s end
  return nil
end

local Players      = getService("Players")
local TweenService = getService("TweenService")
local CoreGui      = getService("CoreGui")

local function attachGui(gui)
  if CoreGui then
    local ok = pcall(function() gui.Parent = CoreGui end)
    if ok then return true end
  end
  local ok2 = pcall(function()
    local lp = Players and Players.LocalPlayer
    if not lp then error("LocalPlayer yok") end
    gui.Parent = lp:WaitForChild("PlayerGui")
  end)
  return ok2
end

