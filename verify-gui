    ZIndex = 3,
  }, panel)

  --------------------------------------------------------------
  -- Durum yönetimi
  --------------------------------------------------------------
  local closed = false
  local busy = false

  local function setStatus(text, kind)
    status.Text = text or ""
    if kind == "ok" then status.TextColor3 = C.ok
    elseif kind == "err" then status.TextColor3 = C.err
    else status.TextColor3 = C.muted end
  end

  -- Fade listeleri: tüm elemanlar kurulduktan SONRA, orijinal değerler korunarak toplanır
  local FADE = {
    menu  = collectFade(menuView),
    login = collectFade(loginView),
    reg   = collectFade(regView),
  }

  local function show(view, list, others)
    for _, v in ipairs(others) do
      pcall(function() v.Visible = false end)
    end
    pcall(function() view.Visible = true end)

    -- önce tamamen saydam yap
    for _, e in ipairs(list) do
      pcall(function() e[1][e[2]] = 1 end)
    end
    -- sonra orijinal değere tween et (tween olmazsa anında uygula)
    for _, e in ipairs(list) do
      local done = false
      if TweenService then
        done = pcall(function()
          TweenService:Create(
            e[1],
            TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { [e[2]] = e[3] }
          ):Play()
        end)
      end
      if not done then
        pcall(function() e[1][e[2]] = e[3] end)
      end
    end
  end

  local function showMenu()     show(menuView,  FADE.menu,  { loginView, regView }) end
  local function showLogin()    show(loginView, FADE.login, { menuView, regView }) end
  local function showRegister() show(regView,   FADE.reg,   { menuView, loginView }) end

  showMenu()

  --------------------------------------------------------------
  -- Buton olayları
  --------------------------------------------------------------
  loginBtn.MouseButton1Click:Connect(function()
    if busy then return end
    setStatus("", "muted")
    showLogin()
  end)
  regBtn.MouseButton1Click:Connect(function()
    if busy then return end
    setStatus("", "muted")
    showRegister()
  end)
  lBack.MouseButton1Click:Connect(function()
    if busy then return end
    setStatus("", "muted")
    showMenu()
  end)
  rBack.MouseButton1Click:Connect(function()
    if busy then return end
    setStatus("", "muted")
    showMenu()
  end)

  -- Ortak gönderim: başarıda busy AÇIK kalır (panel kapanırken tekrar tıklanamasın)
  local function submit(handler, busyMsg, okMsg, failMsg, ...)
    if busy or closed then return end
    busy = true
    setStatus(busyMsg, "muted")

    local called, ok, msg
    if type(handler) == "function" then
      called, ok, msg = pcall(handler, ...)
    else
      called, ok, msg = true, false, "Sistem hazır değil."
    end
    if not called then
      ok, msg = false, "Hata: " .. tostring(ok)
    end

    if ok == true then
      setStatus(okMsg, "ok")
    else
      busy = false
      setStatus(tostring(msg or failMsg), "err")
    end
  end

  local function doLogin()
    if busy or closed then return end
    local nick = (lNick.box.Text or ""):match("^%s*(.-)%s*$")
    local pass = lPass.box.Text or ""
    if nick == "" or pass == "" then
      setStatus("Takma ad ve şifre boş olamaz.", "err")
      return
    end
    submit(opts.onLogin, "Giriş yapılıyor...", "Giriş başarılı.", "Giriş yapılamadı.", nick, pass)
  end

  local function doRegister()
    if busy or closed then return end
    local name = (rName.box.Text or ""):match("^%s*(.-)%s*$")
    local nick = (rNick.box.Text or ""):match("^%s*(.-)%s*$")
    local pass = rPass.box.Text or ""
    if nick == "" then
      setStatus("Takma ad boş olamaz.", "err")
      return
    end
    if pass == "" then
      setStatus("Şifre boş olamaz.", "err")
      return
    end
    submit(opts.onRegister, "Hesap oluşturuluyor...", "Hesap oluşturuldu!", "Hesap oluşturulamadı.", name, nick, pass)
  end

  lGo.MouseButton1Click:Connect(doLogin)
  rGo.MouseButton1Click:Connect(doRegister)

  -- Enter ile gönder
  lPass.box.FocusLost:Connect(function(enterPressed)
    if enterPressed then doLogin() end
  end)
  rPass.box.FocusLost:Connect(function(enterPressed)
    if enterPressed then doRegister() end
  end)

  --------------------------------------------------------------
  -- Açılış / kapanış animasyonu
  --------------------------------------------------------------
  panel.BackgroundTransparency = 1
  shadow.BackgroundTransparency = 1
  title.TextTransparency = 1
  sub.TextTransparency = 1
  foot.TextTransparency = 1
  accentBar.BackgroundTransparency = 1

  tw(panel,  { BackgroundTransparency = 0, Position = UDim2.fromScale(0.5, 0.5) }, 0.4)
  tw(shadow, { BackgroundTransparency = 0.93, Position = UDim2.new(0.5, 0, 0.5, 10) }, 0.4)
  tw(title,  { TextTransparency = 0 }, 0.3, 0.10)
  tw(sub,    { TextTransparency = 0 }, 0.3, 0.16)
  tw(foot,   { TextTransparency = 0 }, 0.3, 0.22)
  tw(accentBar, { BackgroundTransparency = 0 }, 0.3, 0.22)

  local api = {
    gui = gui,
    panel = panel,
    setStatus = setStatus,
    showMenu = showMenu,
    showLogin = showLogin,
    showRegister = showRegister,
    isOpen = function() return not closed end,
    close = function()
      if closed then return end
      closed = true
      tw(panel, { BackgroundTransparency = 1 }, 0.3)
      tw(shadow, { BackgroundTransparency = 1 }, 0.3)
      sleep(0.35)
      pcall(function() gui.Enabled = false end)
      pcall(function() gui:Destroy() end)
    end,
  }
  return api
end

