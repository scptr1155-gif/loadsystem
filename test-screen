--[[
  test-screen | LOAD SYSTEM — EKRAN TESTI

  Tek isi: oyunda siyah ekran + "LOADING TESTI" yazisi gosterir.
  Bu gorunuyorsa executor'da GUI (Instance/ScreenGui/CoreGui) calisiyor demektir.
  Gorunmuyorsa sorun executor ortamindadir (ya da oyun CoreGui'yi engelliyor).

  Calistir:
  loadstring(game:HttpGet("https://raw.githubusercontent.com/scptr1155-gif/loadsystem/refs/heads/main/test-screen"))()
]]

print("[test-screen] basliyor")

local function try(label, fn)
  local ok, res = pcall(fn)
  print(("[test-screen] %s -> %s"):format(label, ok and "OK" or ("HATA: " .. tostring(res))))
  return ok, res
end

try("Instance.new", function() return Instance.new("ScreenGui") end)
try("game:GetService CoreGui", function() return game:GetService("CoreGui") end)
try("game:GetService PlayerGui", function()
  return game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
end)

local gui = Instance.new("ScreenGui")
gui.Name = "LoadSystemTestScreen"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 999
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local parented = false
local okCore = pcall(function() gui.Parent = game:GetService("CoreGui") end)
if okCore then parented = true end
if not parented then
  pcall(function()
    gui.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
  end)
  parented = gui.Parent ~= nil
end
print("[test-screen] ekran yerlestirildi: " .. tostring(parented))

local bg = Instance.new("Frame")
bg.Size = UDim2.new(1, 0, 1, 0)
bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
bg.BorderSizePixel = 0
bg.ZIndex = 1
bg.Parent = gui

local title = Instance.new("TextLabel")
title.Size = UDim2.fromOffset(900, 60)
title.Position = UDim2.fromScale(0.5, 0.42)
title.AnchorPoint = Vector2.new(0.5, 0.5)
title.BackgroundTransparency = 1
title.Text = "LOADING TESTI"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextSize = 42
title.Font = Enum.Font.GothamBold
title.TextXAlignment = Enum.TextXAlignment.Center
title.ZIndex = 2
title.Parent = bg

local sub = Instance.new("TextLabel")
sub.Size = UDim2.fromOffset(900, 24)
sub.Position = UDim2.fromScale(0.5, 0.5)
sub.AnchorPoint = Vector2.new(0.5, 0.5)
sub.BackgroundTransparency = 1
sub.Text = "GUI CALISIYOR - BU EKRAN SILINEBILIR"
sub.TextColor3 = Color3.fromRGB(150, 152, 158)
sub.TextSize = 14
sub.Font = Enum.Font.GothamMedium
sub.TextXAlignment = Enum.TextXAlignment.Center
sub.ZIndex = 2
sub.Parent = bg

print("[test-screen] ekran olusturuldu (3 sn sonra kaybolacak)")
task.delay(3, function()
  pcall(function() gui:Destroy() end)
  print("[test-screen] bitti")
end)
