-- search-profile | OYUNCU ARA + PROFİL (v1.0)  -> loadsystem deposuna "search-profile" adıyla yükle
-- =========================================================
-- main-menu'deki OYUNCU ARA tuşu (veya scripthub) bu dosyayı indirir ve open(ctx) çağırır.
--
--  * Takma adı yazdıkça oyuncular listelenir (resim + takma ad). Boş aramada en çok çalıştırılan yazarlar çıkar.
--  * Birine tıklayınca LOADING ekranı, sonra profil: resim, durum, hakkında, katılma tarihi, Roblox hesap tarihi,
--    yayınlanan script sayısı, toplam çalıştırma, oylar, sıralama ve yayınladığı scriptler.
--  * Kendi profilinde PROFİLİ DÜZENLE: durum, hakkında, profil resmi (rbxassetid; boşsa Roblox avatarı).
--  * Veriler: loadsystem/player (sadece takma ad + Roblox adı okunur, şifre okunmaz), roblox-game-star/profiles.json,
--    roblox-game-star/hub-index.json. Gereken: hubcore v1.1
--
-- ctx: { lang, accent, bg, anim, nick, player, onBack }

local G = (type(getgenv) == "function" and getgenv()) or _G
local S = G.__LOADSYS or {}
G.__LOADSYS = S

local BASE = "https://raw.githubusercontent.com/scptr1155-gif/loadsystem/refs/heads/main/"
local NEED = "1.1"

local function loadCore()
  if type(S.CORE) == "table" and S.CORE.version == NEED then return S.CORE end
  local ok, src = pcall(function() return game:HttpGet(BASE .. "hubcore?t=" .. tostring(os.time())) end)
  if not ok or type(src) ~= "string" or type(loadstring) ~= "function" then return nil end
  local fn = loadstring(src)
  if not fn then return nil end
  local okR, c = pcall(fn)
  if okR and type(c) == "table" then return c end
  return nil
end

