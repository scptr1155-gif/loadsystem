local function touchProfile(nickName)
  local key = string.lower(nickName)
  if S.TOUCHED[key] then return end
  local core = nil
  if type(S.CORE) == "table" and S.CORE.version == CORE_NEED then
    core = S.CORE
  else
    local okH, src = pcall(function() return game:HttpGet(BASE .. "hubcore?t=" .. tostring(os.time())) end)
    if okH and type(src) == "string" and type(loadstring) == "function" then
      local fn = loadstring(src)
      if fn then
        local okR, c = pcall(fn)
        if okR and type(c) == "table" then core = c end
      end
    end
  end
  if core and type(core.touchProfile) == "function" then
    local okT, res = pcall(core.touchProfile, nickName, settings.lang or "tr")
    if okT and res then S.TOUCHED[key] = true end
  end
end

