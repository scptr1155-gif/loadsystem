    TextSize = 11,
    Font = Enum.Font.Gotham,
    TextXAlignment = Enum.TextXAlignment.Left,
    ZIndex = 2,
  }, bg)

  --------------------------------------------------------------
  -- Buton davranışları
  --------------------------------------------------------------
  local function setStatus(text, color)
    safe(function()
      status.Text = text
      status.TextColor3 = color or C.muted
