  local function computeScale()
    local vp = Vector2.new(1280, 720)
    safe(function()
      local cam = Workspace and Workspace.CurrentCamera
      if cam then vp = cam.ViewportSize end
    end)
    local fit = math.min((vp.X - 24) / WIN_W, (vp.Y - 24) / WIN_H)
    if fit <= 0 then fit = 1 end
    local mult = SCALES[settings.scale] or 1
    return math.max(0.35, math.min(fit, math.min(fit, 1) * mult))
  end

  local function fitWindow(animated)
    local s = computeScale()
    if animated then
      tw(uiScale, { Scale = s }, 0.25)
    else
      safe(function() uiScale.Scale = s end)
    end
  end

