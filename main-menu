  local switchToken = 0
  goTo = function(idx, instant)
    if idx == current or not pages[idx] then return end
    local old = current
    current = idx
    switchToken = switchToken + 1
    local token = switchToken

    refreshNav()
    if idx == 3 and refreshVip then refreshVip(false) end
    tw(indicator, { Position = UDim2.fromOffset(0, NAV_Y[navIndex(idx)] + 10) }, 0.3, 0, Enum.EasingStyle.Quint)

    for i, pf in ipairs(pages) do
      if i ~= old and i ~= idx then pf.Visible = false end
    end

    local newF = pages[idx]
    if old == 0 or instant then
      newF.Position = UDim2.fromOffset(0, 0)
      newF.Visible = true
      return
    end
    local dir = (idx > old) and 1 or -1
    local oldF = pages[old]
    newF.Position = UDim2.new(dir, 0, 0, 0)
    newF.Visible = true
    tw(newF, { Position = UDim2.new(0, 0, 0, 0) }, 0.4, 0, Enum.EasingStyle.Quint)
    tw(oldF, { Position = UDim2.new(-dir, 0, 0, 0) }, 0.4, 0, Enum.EasingStyle.Quint)
    delay(0.45, function()
      if token == switchToken then safe(function() oldF.Visible = false end) end
    end)
  end

