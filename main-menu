    local hasHook = (type(S.onStart) == "function")
    local hasUrl = (type(CONFIG.START_URL) == "string" and CONFIG.START_URL ~= "")
    if not hasHook and not hasUrl then
      toast("Script tanımlı değil. main-menu içindeki START_URL alanını doldur.", C.muted)
      return
    end
    starting = true
    toast("Script başlatılıyor...", accent)
    spawn(function()
      local ok, err = pcall(function()
        if hasHook then
          S.onStart(S.SESSION)
        else
          local src = game:HttpGet(CONFIG.START_URL)
          local fn, cerr = loadstring(src)
          if not fn then error(cerr) end
          fn()
