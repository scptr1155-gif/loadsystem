local ok, menu = pcall(build)
if ok and menu then
  S.MAIN = menu
  S.MAIN_READY = true
  print("[main-menu] hazir: " .. tostring(menu.nickname))
else
  S.MAIN_READY = nil
  print("[main-menu] HATA: " .. tostring(menu))
end

return {
  version = CONFIG.VERSION,
  menu = (ok and menu) or nil,
  ready = (S.MAIN_READY == true),
  destroy = function()
    if ok and menu and menu.destroy then menu.destroy() end
  end,
}
