      Size = UDim2.fromOffset(268, 62),
      Position = UDim2.fromOffset(36, y),
      BackgroundColor3 = (kind == "primary") and C.accent or C.card,
      BorderSizePixel = 0,
      Text = "",
      AutoButtonColor = false,
      ZIndex = 3,
    }, menuCard)
    round(b, 14)
    if kind ~= "primary" then stroke(b, C.line, 1) end

    new("TextLabel", {
      Size = UDim2.fromOffset(180, 22),
      Position = UDim2.fromOffset(18, 12),
      BackgroundTransparency = 1,
      Text = text,
      TextColor3 = C.text,
      TextSize = 14,
      Font = Enum.Font.GothamBold,
      TextXAlignment = Enum.TextXAlignment.Left,
      ZIndex = 4,
    }, b)

    new("TextLabel", {
      Size = UDim2.fromOffset(230, 18),
      Position = UDim2.fromOffset(18, 34),
      BackgroundTransparency = 1,
      Text = sub,
      TextColor3 = (kind == "primary") and Color3.fromRGB(210, 216, 255) or C.faint,
      TextSize = 10,
      Font = Enum.Font.Gotham,
      TextXAlignment = Enum.TextXAlignment.Left,
      ZIndex = 4,
    }, b)

    -- sağdaki işaret kutusu
