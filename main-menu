        ok, mod = false, "open() fonksiyonu yok"
      end
      local rest = 1.0 - (os.clock() - t0)
      if rest > 0 then sleep(rest) end
      busyLoad = false
      if not alive then return end
      if ok then
        local ctx = {
          lang = settings.lang or "tr", accent = accent, bg = settings.bg, anim = settings.anim,
          nick = nick, player = pname, menuUrl = CONFIG.MENU_URL,
        }
        if type(extraCtx) == "table" then
          for k, v in pairs(extraCtx) do ctx[k] = v end
        end
        closeMenu(function()
          local okO, errO = pcall(mod.open, ctx)
          if not okO then
            print("[main-menu] ekran acilamadi: " .. tostring(errO))
            fallbackMenu()
          end
        end)
      else
        print("[main-menu] ekran basarisiz (" .. tostring(url) .. "): " .. tostring(mod))
        hideLoading()
        sleep(0.35)
        toast(T("not_ready") .. " [" .. tostring(mod):sub(1, 80) .. "]", C.danger)
      end
    end)
  end

