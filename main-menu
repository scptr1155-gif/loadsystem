local function loadSettings()
  safe(function()
    if type(isfile) == "function" and type(readfile) == "function" and HttpService and isfile(CONFIG.SETTINGS_FILE) then
      local data = HttpService:JSONDecode(readfile(CONFIG.SETTINGS_FILE))
      if type(data) == "table" then
        if type(data.accent) == "number" and ACCENTS[data.accent] then settings.accent = data.accent end
        if type(data.scale) == "number" and SCALES[data.scale] then settings.scale = data.scale end
        if type(data.anim) == "boolean" then settings.anim = data.anim end
      end
    end
  end)
end

local function saveSettings()
  safe(function()
    if canSave and HttpService then
      writefile(CONFIG.SETTINGS_FILE, HttpService:JSONEncode(settings))
    end
  end)
end

