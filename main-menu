local function applyGoal(obj, goal)
  if not obj or type(goal) ~= "table" then return end
  for k, v in pairs(goal) do safe(function() obj[k] = v end) end
end

local function tw(obj, goal, time, delayT, style, dir)
  if not obj then return nil end
  if not TweenService or not settings.anim then
    applyGoal(obj, goal)
    return nil
  end
  local ok, t = pcall(function()
    return TweenService:Create(obj,
      TweenInfo.new(time or 0.2, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out, 0, false, delayT or 0), goal)
  end)
  if ok and t and pcall(function() t:Play() end) then return t end
  applyGoal(obj, goal)
  return nil
end

