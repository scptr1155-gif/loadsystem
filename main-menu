    Position = UDim2.fromOffset(36, 52),
    BackgroundTransparency = 1,
    Text = "Bir işlem seç",
    TextColor3 = C.faint,
    TextSize = 11,
    Font = Enum.Font.Gotham,
    TextXAlignment = Enum.TextXAlignment.Left,
    ZIndex = 3,
  }, menuCard)

