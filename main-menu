  fadeIn(accentBar, "BackgroundTransparency", 0.24)
  fadeIn(status, "TextTransparency", 0.3)

  return {
    gui = gui,
    card = menuCard,
    nickname = nick,
    player = pname,
    setStatus = setStatus,
    destroy = function()
      safe(function() gui:Destroy() end)
    end,
  }
end

--------------------------------------------------------------
-- Çalıştır
--------------------------------------------------------------
local ok, menu = pcall(build)
if ok and menu then
  S.MAIN = menu
  S.MAIN_READY = true
  print("[main-menu] hazir: " .. tostring(menu.nickname))
else
  print("[main-menu] HATA: " .. tostring(menu))
end

return {
  version = "1.2.0",
  menu = menu,
  ready = S.MAIN_READY == true,
}
