yerel fonksiyon fetchLoad(url)
  yerel sep = url:find("?", 1, true) ve "&" veya "?"
  local okF, src = pcall(function() return game:HttpGet(url .. sep .. "t=" .. tostring(os.time())) end)
  Eğer okF değilse veya type(src) ~= "string" ise false döndür, "indirilemedi" son
  if #((src:gsub("%s+", ""))) == 0 then return false, "bos dosya" end
  if src:sub(1, 14) == "404: Not Found" then return false, "404" end
  if type(loadstring) ~= "function" then return false, "loadstring yok" end
  yerel fonksiyon, cerr = loadstring(src)
  Eğer fn değilse false döndür, tostring(cerr) son
  yerel okR, mod = pcall(fn)
  Eğer okR değilse false döndür, tostring(mod) son
  true döndür, mod
son

