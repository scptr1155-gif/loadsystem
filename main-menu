    safe(function() obj[prop] = 1 end)
    tw(obj, { [prop] = val }, 0.4, delay)
  end

  safe(function() menuCard.BackgroundTransparency = 1 end)
  safe(function() hero.BackgroundTransparency = 1 end)
  safe(function() chip.BackgroundTransparency = 1 end)
  safe(function() logo.BackgroundTransparency = 1 end)
  safe(function() top.BackgroundTransparency = 1 end)

  tw(menuCard, { BackgroundTransparency = 0 }, 0.45)
  tw(hero, { BackgroundTransparency = 0 }, 0.45, 0.06)
  tw(chip, { BackgroundTransparency = 0 }, 0.4, 0.12)
  tw(logo, { BackgroundTransparency = 0 }, 0.4, 0.02)
  tw(top, { BackgroundTransparency = 0 }, 0.3, 0.02)

