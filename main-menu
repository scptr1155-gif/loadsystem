    setBtn.MouseButton1Click:Connect(function() setStatus("Ayarlar paneli yakinda.", C.muted) end)
    credBtn.MouseButton1Click:Connect(function() setStatus("Hesap: " .. tostring(nick) .. " — etkin", C.ok) end)
    exitBtn.MouseButton1Click:Connect(function() setStatus("Oturum kapatildi.", C.danger) end)
  end)

  --------------------------------------------------------------
