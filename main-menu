local function sleep(s)
  s = s or 0
  if type(task) == "table" and type(task.wait) == "function" then task.wait(s)
  elseif type(wait) == "function" then wait(s) end
end

local function spawn(fn, ...)
  if type(task) == "table" and type(task.spawn) == "function" then return task.spawn(fn, ...) end
  local co = coroutine.create(fn)
  coroutine.resume(co, ...)
  return co
end

local function delay(t, fn)
  if type(task) == "table" and type(task.delay) == "function" then return task.delay(t, fn) end
  spawn(function()
    sleep(t)
    fn()
  end)
end

local function attachGui(gui)
  if CoreGui then
    local ok = pcall(function() gui.Parent = CoreGui end)
    if ok and gui.Parent == CoreGui then return true end
  end
  local ok2 = pcall(function()
    local lp = Players and Players.LocalPlayer
    if not lp then error("LocalPlayer yok") end
    gui.Parent = lp:WaitForChild("PlayerGui")
  end)
  return ok2
end

