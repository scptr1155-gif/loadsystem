--[[
  main-menu | LOAD SYSTEM — ANA MENÜ (v1.2)
  =========================================================
  `verify` tarafından giriş/kayıt başarılı olduktan sonra indirilip çalıştırılır.
  Arayüzü kurar ve hazır olduğunu S.MAIN_READY = true ile bildirir
  (verify bu bayrağı izleyip siyah perdeyi kaldırır).

  Tasarım notları:
    - Roblox tarzı "kare delik" logo GUI ile çizildi (harici görsel gerektirmez)
    - AnchorPoint her zaman Vector2
    - GroupTransparency KULLANILMAZ (bazı surumlerde Frame uyesi degil)
    - Tum ozellik atamalari pcall ile korunur (tek hata paneli cokertmez)
]]

local G = (type(getgenv) == "function" and getgenv()) or _G
local S = G.__LOADSYS or {}
G.__LOADSYS = S

local function safe(fn, ...)
  local ok, a, b = pcall(fn, ...)
  if ok then return true, a, b end
  return false, a
end

local function getService(name)
  local ok, s = safe(function() return game:GetService(name) end)
  if ok then return s end
  return nil
end

local Players      = getService("Players")
local TweenService = getService("TweenService")
local CoreGui      = getService("CoreGui")

--------------------------------------------------------------
-- Yardımcılar
--------------------------------------------------------------
local function new(class, props, parent)
  local ok, o = pcall(function() return Instance.new(class) end)
  if not ok or not o then return nil end
  if props then
    for k, v in pairs(props) do
      safe(function() o[k] = v end)
    end
  end
  if parent then safe(function() o.Parent = parent end) end
  return o
end

local function round(obj, radius)
  if not obj then return end
  local c = new("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
  if c then c.Parent = obj end
end

local function stroke(obj, color, thickness)
  if not obj then return end
  local s = new("UIStroke", {
    ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    Color = color,
    Thickness = thickness or 1,
  })
  if s then s.Parent = obj end
end

local function applyGoal(obj, goal)
  if not obj or type(goal) ~= "table" then return end
  for k, v in pairs(goal) do
    safe(function() obj[k] = v end)
  end
end

local function tw(obj, goal, time, delay)
  if not TweenService then
    applyGoal(obj, goal)
    return nil
  end
  local ok, t = pcall(function()
    return TweenService:Create(
      obj,
      TweenInfo.new(time or 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, delay or 0),
      goal
    )
  end)
  if ok and t then
    local played = pcall(function() t:Play() end)
    if played then return t end
  end
  applyGoal(obj, goal)
  return nil
end

