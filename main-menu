local function new(class, props, parent)
  local ok, o = pcall(function() return Instance.new(class) end)
  if not ok or not o then return nil end
  if props then
    for k, v in pairs(props) do
      safe(function() o[k] = v end)
    end
  end
  if parent then safe(function() o.Parent = parent end) end
  return o
end

local function round(obj, r, isScale)
  if not obj then return end
  new("UICorner", { CornerRadius = isScale and UDim.new(r, 0) or UDim.new(0, r or 12) }, obj)
end

local function stroke(obj, color, thickness)
  if not obj then return nil end
  return new("UIStroke", {
    ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    Color = color,
    Thickness = thickness or 1,
  }, obj)
end

local function applyGoal(obj, goal)
  if not obj or type(goal) ~= "table" then return end
  for k, v in pairs(goal) do
    safe(function() obj[k] = v end)
  end
end

-- Animasyonlar kapalıysa (ayarlardan) değerler anında uygulanır
local function tw(obj, goal, time, delayT, style, dir)
  if not obj then return nil end
  if not TweenService or not settings.anim then
    applyGoal(obj, goal)
    return nil
  end
  local ok, t = pcall(function()
    return TweenService:Create(
      obj,
      TweenInfo.new(time or 0.2, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out, 0, false, delayT or 0),
      goal
    )
  end)
  if ok and t then
    local played = pcall(function() t:Play() end)
    if played then return t end
  end
  applyGoal(obj, goal)
  return nil
end

local function label(parent, text, x, y, w, h, size, font, color, align, extra)
  local props = {
    Size = UDim2.fromOffset(w, h),
    Position = UDim2.fromOffset(x, y),
    BackgroundTransparency = 1,
    Text = text,
    TextColor3 = color,
    TextSize = size,
    Font = font,
    TextXAlignment = align or AL,
    TextYAlignment = Enum.TextYAlignment.Center,
    ZIndex = 3,
  }
  if extra then
    for k, v in pairs(extra) do props[k] = v end
  end
  return new("TextLabel", props, parent)
end

-- Vurgu rengini kullanan nesneleri kaydet (renk değişince hepsi güncellenir)
local function useAccent(obj, prop)
  if not obj then return end
  prop = prop or "BackgroundColor3"
  accentObjs[#accentObjs + 1] = { obj = obj, prop = prop }
  safe(function() obj[prop] = accent end)
end

-- Ayar ekranından çağrılan yenileme fonksiyonları (build içinde atanır)
local refreshNav, refreshSwatches, refreshToggle, refreshScale

local function setAccent(idx)
  if not ACCENTS[idx] then return end
  settings.accent = idx
  accent = ACCENTS[idx].color
  accentHi = accent:Lerp(Color3.new(1, 1, 1), 0.18)
  for _, r in ipairs(accentObjs) do
    local has = false
    safe(function() has = (r.obj.Parent ~= nil) end)
    if has then tw(r.obj, { [r.prop] = accent }, 0.25) end
  end
  if refreshNav then refreshNav() end
  if refreshSwatches then refreshSwatches() end
  if refreshToggle then refreshToggle() end
  if refreshScale then refreshScale() end
end

local function fmtTime(sec)
  if sec < 0 then sec = 0 end
  local h = math.floor(sec / 3600)
  local m = math.floor((sec % 3600) / 60)
  local s = math.floor(sec % 60)
  if h > 0 then return string.format("%d:%02d:%02d", h, m, s) end
  return string.format("%02d:%02d", m, s)
end

