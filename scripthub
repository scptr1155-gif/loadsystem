    Name = "LoadSystemHub", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 800,
    ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
  })
  if not gui then return end
  local attached = false
  if CoreGui then attached = pcall(function() gui.Parent = CoreGui end) and gui.Parent == CoreGui end
  if not attached then
    pcall(function() gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui") end)
  end
  S.HUB_GUI = gui

