    Size = UDim2.fromOffset(WIN_W, WIN_H), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
    BackgroundColor3 = C.panel, BorderSizePixel = 0, ZIndex = 2,
  }, bg)
  round(window, 18)
  stroke(window, C.line)
  local uiScale = new("UIScale", { Scale = 1 }, window)
  local function fit()
    local vp = Vector2.new(1280, 720)
    safe(function() local cam = Workspace.CurrentCamera if cam then vp = cam.ViewportSize end end)
    local s = math.min((vp.X - 24) / WIN_W, (vp.Y - 24) / WIN_H, 1)
    if s <= 0 then s = 1 end
    safe(function() uiScale.Scale = math.max(0.35, s) end)
  end
  fit()
  local camConn
  safe(function()
    camConn = Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
  end)

  local function close()
    alive = false
    safe(function() if camConn then camConn:Disconnect() end end)
    safe(function() gui:Destroy() end)
    if S.HUB_GUI == gui then S.HUB_GUI = nil end
  end

  -- Bildirim
  local toastF = new("Frame", {
    Size = UDim2.fromOffset(640, 42), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 70),
    BackgroundColor3 = C.cardHi, BorderSizePixel = 0, Visible = false, ZIndex = 60,
  }, window)
  round(toastF, 21)
  stroke(toastF, C.line)
  local toastDot = new("Frame", {
    Size = UDim2.fromOffset(8, 8), Position = UDim2.fromOffset(18, 17), BackgroundColor3 = C.muted, BorderSizePixel = 0, ZIndex = 61,
  }, toastF)
