    }, window)
    round(b, 9)
    stroke(b, C.line)
    tabBtns[i] = b
    b.MouseButton1Click:Connect(function()
      sort = t[1]
      refreshTabs()
      refresh()
    end)
  end

  local idF = new("Frame", {
    Size = UDim2.fromOffset(170, 32), Position = UDim2.fromOffset(WIN_W - PAD - 250, 82), BackgroundColor3 = C.card,
    BorderSizePixel = 0, ZIndex = 3,
