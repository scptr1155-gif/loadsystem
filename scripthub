-- scripthub | SCRIPT HUB — AYRI BÖLÜM (v3.0)
-- =========================================================
-- main-menu bu dosyayı indirir, ana menüyü kapatır ve open(ctx) çağırır.
-- v3.0:
-- * Kartlarda ÇALIŞTIR yerine AÇ: loading -> roblox-game-star/script-menu çalışır ->
--   menü açılır (çalıştır, iyi/kötü oy).
-- * Üst çubukta CREATE, STUDİO ve PROFİL. Hepsi aynı hubcore kütüphanesini kullanır.
-- * X ile küçültme (CR logosu) tüm ekranlarda aynı.
--
-- ctx: { lang="tr"|"en", accent=Color3, bg=bool, anim=bool, nick, player, menuUrl }

local G = (type(getgenv) == "function" and getgenv()) or _G
local S = G.__LOADSYS or {}
G.__LOADSYS = S

local BASE = "https://raw.githubusercontent.com/scptr1155-gif/loadsystem/refs/heads/main/"
local MAX_ID = 999999999
local MODULES = {
  create  = BASE .. "create%20a%20code",
  studio  = BASE .. "studio",
  profile = BASE .. "profile",
}

local function loadCore()
  if type(S.CORE) == "table" then return S.CORE end
  local ok, src = pcall(function() return game:HttpGet(BASE .. "hubcore?t=" .. tostring(os.time())) end)
  if not ok or type(src) ~= "string" or type(loadstring) ~= "function" then return nil end
  local fn = loadstring(src)
  if not fn then return nil end
  local okR, c = pcall(fn)
  if okR and type(c) == "table" then return c end
  return nil
end

local STR = {
  tr = {
    back = "← GERİ", title = "Script Hub", create = "CREATE", studio = "STUDİO", profile = "PROFİL",
    t_new = "EN YENİ", t_top = "EN YÜKSEK PUAN", t_pop = "POPÜLER",
    id_ph = "ID (1-999999999)", go = "GİT", open = "AÇ",
    empty = "Henüz script yok.", none_found = "Bu ID ile script bulunamadı.",
    loading = "Yükleniyor...", by = "yazar", bad_id = "Geçerli bir ID gir (1-999999999).",
    ld_open = "YÜKLENİYOR", ld_create = "OLUŞTURMA ARAÇLARI YÜKLENİYOR",
    ld_studio = "STUDİO YÜKLENİYOR", ld_profile = "PROFİL YÜKLENİYOR", ld_sub = "LÜTFEN BEKLE",
    not_ready = "Sistem daha kurulmadı.", menu_fail = "Ana menü indirilemedi. Bağlantını kontrol et.",
    menu_open_fail = "Menü açılamadı: ", nodesc = "Açıklama yok",
  },
  en = {
    back = "← BACK", title = "Script Hub", create = "CREATE", studio = "STUDIO", profile = "PROFILE",
    t_new = "NEWEST", t_top = "TOP RATED", t_pop = "POPULAR",
    id_ph = "ID (1-999999999)", go = "GO", open = "OPEN",
    empty = "No scripts yet.", none_found = "No script found with that ID.",
    loading = "Loading...", by = "by", bad_id = "Enter a valid ID (1-999999999).",
    ld_open = "LOADING", ld_create = "LOADING CREATE TOOLS",
    ld_studio = "LOADING STUDIO", ld_profile = "LOADING PROFILE", ld_sub = "PLEASE WAIT",
    not_ready = "The system is not set up yet.", menu_fail = "Could not download the main menu. Check your connection.",
    menu_open_fail = "Could not open menu: ", nodesc = "No description",
  },
}

local M = {}

function M.open(ctx)
  ctx = ctx or {}
  local core = loadCore()
  if not core then
    print("[scripthub] hubcore yuklenemedi, ana menuye donuluyor")
    pcall(function()
      S.MAIN_READY = nil
      loadstring(game:HttpGet((ctx.menuUrl or (BASE .. "main-menu")) .. "?t=" .. tostring(os.time())))()
    end)
    return
  end

  local lang = (ctx.lang == "en") and "en" or "tr"
  local function T(k) return STR[lang][k] or STR.tr[k] or k end
  local num, pad, spawn, sleep = core.num, core.pad, core.spawn, core.sleep

  local u = core.ui(ctx, { name = "Hub", title = T("title"), back = true, backText = T("back") })
  if not u then return end
  local C, FNT = u.C, u.FNT
  local W, PAD, IW = u.W, u.PAD, u.IW
  local toast = u.toast
  local window = u.window
  local AC = Enum.TextXAlignment.Center

  -- Üst çubuk: CREATE / STUDİO / PROFİL
  local profileBtn = u.pill(T("profile"), W - PAD - 34 - 10 - 100, 24, 100, 38, false)
  local studioBtn  = u.pill(T("studio"), W - PAD - 34 - 10 - 100 - 8 - 100, 24, 100, 38, false)
  local createBtn  = u.pill(T("create"), W - PAD - 34 - 10 - 100 - 8 - 100 - 8 - 110, 24, 110, 38, true)

  --------------------------------------------------------------
  -- Liste
  --------------------------------------------------------------
  local sort = "new"
  local TABS = { { "new", "t_new" }, { "top", "t_top" }, { "popular", "t_pop" } }
  local tabBtns = {}
  local function refreshTabs()
    for i, b in ipairs(tabBtns) do
      local on = (TABS[i][1] == sort)
      u.tw(b, { BackgroundColor3 = on and u.accent or C.card, TextColor3 = on and C.white or C.muted }, 0.2)
    end
  end

  local scroll = u.scroll(PAD, 128, IW, 364)

  local function clearList()
    for _, c in ipairs(scroll:GetChildren()) do
      if c.Name == "Card" or c.Name == "Msg" then core.safe(function() c:Destroy() end) end
    end
  end
  local function showMsg(text)
    clearList()
    u.label(scroll, text, 0, 0, IW, 80, 13, FNT.med, C.faint, { Name = "Msg", TextWrapped = true, TextXAlignment = AC })
  end

  local function listScripts(s)
    local items = {}
    for _, e in ipairs(core.readIndex().scripts) do items[#items + 1] = e end
    local function net(e) return num(e.good) - num(e.bad) end
    if s == "top" then
      table.sort(items, function(a, b)
        if net(a) ~= net(b) then return net(a) > net(b) end
        return num(a.id) > num(b.id)
      end)
    elseif s == "popular" then
      table.sort(items, function(a, b)
        if num(a.uses) ~= num(b.uses) then return num(a.uses) > num(b.uses) end
        return num(a.id) > num(b.id)
      end)
    else
      table.sort(items, function(a, b) return num(a.id) > num(b.id) end)
    end
    return items
  end

  local busy = false

  -- AÇ: loading -> roblox-game-star/script-menu -> menü
  local function refresh() end
  local function openEntry(e)
    if busy or u.locked then return end
    busy = true
    u.loading(true, T("ld_open"), T("ld_sub"))
    spawn(function()
      local t0 = os.clock()
      local ok, mod = core.fetchLoad(core.STORE .. "script-menu")
      if ok and not (type(mod) == "table" and type(mod.open) == "function") then
        ok, mod = false, "script-menu open() yok"
      end
      local rest = 0.8 - (os.clock() - t0)
      if rest > 0 then sleep(rest) end
      busy = false
      if not u.alive() then return end
      u.loading(false)
      if ok then
        local ctx3 = {}
        for k, v in pairs(ctx) do ctx3[k] = v end
        ctx3.onClose = function() if u.alive() then refresh() end end
        local okO, errO = pcall(mod.open, ctx3, e)
        if not okO then toast(T("menu_open_fail") .. tostring(errO):sub(1, 80), C.danger) end
      else
        print("[scripthub] script-menu basarisiz: " .. tostring(mod))
        toast(T("not_ready") .. " [" .. tostring(mod):sub(1, 80) .. "]", C.danger)
      end
    end)
  end

  local function render(list)
    clearList()
    if #list == 0 then showMsg(T("empty")) return end
    for i, e in ipairs(list) do
      if i > 100 then break end
      local card = u.new("Frame", {
        Name = "Card", Size = UDim2.fromOffset(IW - 8, 72), BackgroundColor3 = C.card, BorderSizePixel = 0,
        LayoutOrder = i, ZIndex = 3,
      }, scroll)
      u.round(card, 12)
      u.stroke(card, C.line)
      local thumb = u.new("ImageLabel", {
        Size = UDim2.fromOffset(52, 52), Position = UDim2.fromOffset(10, 10), BackgroundColor3 = C.cardHi,
        BorderSizePixel = 0, ScaleType = Enum.ScaleType.Crop, ZIndex = 4,
      }, card)
      u.round(thumb, 10)
      local img = tonumber(e.image)
      if img and img > 0 then core.safe(function() thumb.Image = "rbxassetid://" .. tostring(math.floor(img)) end) end
      u.label(card, tostring(e.name or "?"), 74, 9, IW - 230, 20, 14, FNT.bold, C.text, { TextTruncate = Enum.TextTruncate.AtEnd })
      local meta = T("by") .. " " .. tostring(e.author or "?") .. "   ID " .. pad(math.floor(num(e.id)))
        .. "   👍 " .. tostring(math.floor(num(e.good))) .. "  👎 " .. tostring(math.floor(num(e.bad)))
        .. "   ▶ " .. tostring(math.floor(num(e.uses)))
      u.label(card, meta, 74, 30, IW - 230, 16, 11, FNT.med, C.muted, { TextTruncate = Enum.TextTruncate.AtEnd })
      local d = tostring(e.desc or "")
      if d == "" then d = T("nodesc") end
      u.label(card, d, 74, 47, IW - 230, 16, 11, FNT.reg, C.faint, { TextTruncate = Enum.TextTruncate.AtEnd })
      local ob = u.pill(T("open"), IW - 8 - 112, 19, 100, 34, true, card)
      ob.MouseButton1Click:Connect(function() openEntry(e) end)
    end
  end

  local reqToken = 0
  refresh = function()
    reqToken = reqToken + 1
    local my, s = reqToken, sort
    showMsg(T("loading"))
    spawn(function()
      local ok, res = pcall(listScripts, s)
      if not u.alive() or my ~= reqToken then return end
      if ok then render(res) else showMsg(T("empty")) end
    end)
  end

  for i, t in ipairs(TABS) do
    local b = u.pill(T(t[2]), PAD + (i - 1) * 158, 82, 150, 32, false)
    b.TextSize = 11
    tabBtns[i] = b
    b.MouseButton1Click:Connect(function()
      sort = t[1]
      refreshTabs()
      refresh()
    end)
  end

  local idBox = u.new("TextBox", {
    Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(10, 0), BackgroundTransparency = 1, Text = "",
    PlaceholderText = T("id_ph"), PlaceholderColor3 = C.faint, TextColor3 = C.text, TextSize = 12, Font = FNT.med,
    ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4,
  }, (function()
    local f = u.new("Frame", {
      Size = UDim2.fromOffset(170, 32), Position = UDim2.fromOffset(W - PAD - 250, 82), BackgroundColor3 = C.card,
      BorderSizePixel = 0, ZIndex = 3,
    }, window)
    u.round(f, 9)
    u.stroke(f, C.line)
    return f
  end)())
  local goBtn = u.pill(T("go"), W - PAD - 72, 82, 72, 32, false)
  goBtn.TextSize = 11

  local function searchId()
    local txt = core.trim(idBox.Text)
    local id = tonumber(txt)
    if not id or id < 1 or id > MAX_ID or id ~= math.floor(id) then toast(T("bad_id"), C.danger) return end
    showMsg(T("loading"))
    spawn(function()
      local found
      for _, e in ipairs(core.readIndex().scripts) do
        if num(e.id) == id then found = e break end
      end
      if not u.alive() then return end
      if found then render({ found }) else showMsg(T("none_found")) end
    end)
  end
  goBtn.MouseButton1Click:Connect(searchId)
  idBox.FocusLost:Connect(function(enter) if enter then searchId() end end)

  --------------------------------------------------------------
  -- CREATE / STUDİO / PROFİL (ayrı bölümler)
  --------------------------------------------------------------
  local function openModule(key, loadKey)
    if busy or u.locked then return end
    busy = true
    u.loading(true, T(loadKey), T("ld_sub"))
    spawn(function()
      local t0 = os.clock()
      local ok, mod = core.fetchLoad(MODULES[key])
      if ok and not (type(mod) == "table" and type(mod.open) == "function") then
        ok, mod = false, key .. " open() yok"
      end
      local rest = 1.0 - (os.clock() - t0)
      if rest > 0 then sleep(rest) end
      busy = false
      if not u.alive() then return end
      if ok then
        local ctx2 = {}
        for k, v in pairs(ctx) do ctx2[k] = v end
        ctx2.onBack = function() M.open(ctx) end
        u.close()
        local okO, errO = pcall(mod.open, ctx2)
        if not okO then
          print("[scripthub] " .. key .. " acilamadi: " .. tostring(errO))
          M.open(ctx)
        end
      else
        print("[scripthub] " .. key .. " basarisiz: " .. tostring(mod))
        u.loading(false)
        toast(T("not_ready") .. " [" .. tostring(mod):sub(1, 80) .. "]", C.danger)
      end
    end)
  end
  createBtn.MouseButton1Click:Connect(function() openModule("create", "ld_create") end)
  studioBtn.MouseButton1Click:Connect(function() openModule("studio", "ld_studio") end)
  profileBtn.MouseButton1Click:Connect(function() openModule("profile", "ld_profile") end)

  --------------------------------------------------------------
  -- GERİ: ana menüyü yeniden yükle
  --------------------------------------------------------------
  u.backBtn.MouseButton1Click:Connect(function()
    if u.locked or busy then return end
    u.locked = true
    spawn(function()
      local src = core.httpGet(ctx.menuUrl or (BASE .. "main-menu"))
      local fn, err
      if src and type(loadstring) == "function" then fn, err = loadstring(src) end
      if not fn then
        u.locked = false
        print("[scripthub] main-menu yuklenemedi: " .. tostring(err))
        toast(T("menu_fail"), C.danger)
        return
      end
      u.close()
      S.MAIN_READY = nil
      local okR, errR = pcall(fn)
      if not okR then print("[scripthub] main-menu hatasi: " .. tostring(errR)) end
    end)
  end)

  refreshTabs()
  refresh()
end

return M
