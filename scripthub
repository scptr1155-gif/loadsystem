local function getService(n)
  local ok, s = pcall(function() return game:GetService(n) end)
  if ok and s then return s end
  return nil
end
local Players, TweenService, CoreGui = getService("Players"), getService("TweenService"), getService("CoreGui")
local HttpService, Workspace = getService("HttpService"), getService("Workspace")

local function sleep(s)
  if type(task) == "table" and type(task.wait) == "function" then task.wait(s or 0)
  elseif type(wait) == "function" then wait(s or 0) end
end
local function spawn(fn, ...)
  if type(task) == "table" and type(task.spawn) == "function" then return task.spawn(fn, ...) end
  local co = coroutine.create(fn)
  coroutine.resume(co, ...)
  return co
end
local function delay(t, fn)
  if type(task) == "table" and type(task.delay) == "function" then return task.delay(t, fn) end
  spawn(function() sleep(t) fn() end)
end
local function safe(fn, ...)
  local ok, a = pcall(fn, ...)
  return ok, a
end

