yerel fonksiyon pad(id) return string.format("%09d", id) end

yerel fonksiyon httpGet(url)
  yerel sep = url:find("?", 1, true) ve "&" veya "?"
  yerel tamam, r = pcall(function() return game:HttpGet(url .. sep .. "t=" .. tostring(os.time())) end)
  Eğer her şey yolundaysa ve type(r) == "string" ise ve #r > 0 ise ve r:sub(1, 14) ~= "404: Not Found" ise, r'yi döndür.
  boş döndür
son

yerel fonksiyon readIndex()
  yerel kaynak = httpGet(DOSYA .. DİZİN_DOSYA)
  Eğer kaynak mevcut değilse, { next = 1, scripts = {} } döndür.
  yerel tamam, d = pcall(function() return HttpService:JSONDecode(src) end)
  Eğer sorun yoksa ve type(d) == "table" ve type(d.scripts) == "table" ise, d'yi döndür.
  return { next = 1, scripts = {} }
son

yerel fonksiyon num(v) tonumber(v) veya 0 döndür son

yerel fonksiyon listScripts(sıralama)
  yerel öğeler = {}
  for _, e in ipairs(readIndex().scripts) do items[#items + 1] = e end
  eğer sıralama "en üst" ise o zaman
    tablo.sırala(öğeler, fonksiyon(a, b))
      Eğer num(a.rating) ~= num(b.rating) ise, num(a.rating) > num(b.rating) değerini döndür.
      return num(a.id) > num(b.id)
    son)
  aksi takdirde eğer sıralama "popüler" ise o zaman
    tablo.sırala(öğeler, fonksiyon(a, b))
      Eğer num(a.uses) ~= num(b.uses) ise, num(a.uses) > num(b.uses) değerini döndür.
      return num(a.id) > num(b.id)
    son)
  başka
    tablo.sırala(öğeler, fonksiyon(a, b) return num(a.id) > num(b.id) end)
  son
  iade ürünleri
son

yerel fonksiyon findScript(id)
  for _, e in ipairs(readIndex().scripts) do
    if num(e.id) == id then return e end
  son
  boş döndür
son

yerel fonksiyon runScript(id)
  yerel kod = httpGet(STORE .. pad(id))
  eğer kod değilse hata ver ("kod indirilemedi") son
  yerel fonksiyon, hata = kod dizesini yükle
  eğer fn değilse hata (err) son
  fn()
son

-- Uzaktaki indir + çalıştır (boş/hata = başarısız)
yerel fonksiyon fetchLoad(url)
  yerel kaynak = httpGet(url)
  Eğer kaynak kod değilse false döndür, "indirilemedi" son
  if #((src:gsub("%s+", ""))) == 0 then return false, "bos dosya" end
  if type(loadstring) ~= "function" then return false, "loadstring yok" end
  yerel fonksiyon, cerr = loadstring(src)
  Eğer fn değilse false döndür, tostring(cerr) son
  yerel okR, mod = pcall(fn)
  Eğer okR değilse false döndür, tostring(mod) son
  true döndür, mod
son

