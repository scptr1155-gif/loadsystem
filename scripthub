-- Veri katmanı (okuma)
--------------------------------------------------------------
local function pad(id) return string.format("%09d", id) end

local function httpGet(url)
  local sep = url:find("?", 1, true) and "&" or "?"
  local ok, r = pcall(function() return game:HttpGet(url .. sep .. "t=" .. tostring(os.time())) end)
  if ok and type(r) == "string" and #r > 0 and r:sub(1, 14) ~= "404: Not Found" then return r end
  return nil
end

local function readIndex()
  local src = httpGet(STORE .. INDEX_FILE)
  if not src then return { next = 1, scripts = {} } end
  local ok, d = pcall(function() return HttpService:JSONDecode(src) end)
  if ok and type(d) == "table" and type(d.scripts) == "table" then return d end
  return { next = 1, scripts = {} }
end

local function num(v) return tonumber(v) or 0 end

local function listScripts(sort)
  local items = {}
  for _, e in ipairs(readIndex().scripts) do items[#items + 1] = e end
  if sort == "top" then
    table.sort(items, function(a, b)
      if num(a.rating) ~= num(b.rating) then return num(a.rating) > num(b.rating) end
      return num(a.id) > num(b.id)
    end)
  elseif sort == "popular" then
    table.sort(items, function(a, b)
      if num(a.uses) ~= num(b.uses) then return num(a.uses) > num(b.uses) end
      return num(a.id) > num(b.id)
    end)
  else
    table.sort(items, function(a, b) return num(a.id) > num(b.id) end)
  end
  return items
end

local function findScript(id)
  for _, e in ipairs(readIndex().scripts) do
    if num(e.id) == id then return e end
  end
  return nil
end

local function runScript(id)
  local code = httpGet(STORE .. pad(id))
  if not code then error("kod indirilemedi") end
  local fn, err = loadstring(code)
  if not fn then error(err) end
  fn()
end

-- Uzak dosyayı indir + çalıştır (boş/hata = başarısız)
local function fetchLoad(url)
  local src = httpGet(url)
  if not src then return false, "indirilemedi" end
  if #((src:gsub("%s+", ""))) == 0 then return false, "bos dosya" end
  if type(loadstring) ~= "function" then return false, "loadstring yok" end
  local fn, cerr = loadstring(src)
  if not fn then
    local ln = tonumber(tostring(cerr):match(":(%d+):"))
    local n, txt = 0, ""
    for line in (src .. "\n"):gmatch("(.-)\n") do
      n = n + 1
      if n == ln then txt = line break end
    end
    print("[loadsystem] derleme hatasi " .. tostring(cerr) .. " | satir: " .. txt:sub(1, 120))
    return false, "L" .. tostring(ln) .. ": " .. txt:sub(1, 50)
  end
  local okR, mod = pcall(fn)
  if not okR then return false, tostring(mod) end
  return true, mod
end

