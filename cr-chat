  local function hhmm(ts)
    local ok, s = pcall(os.date, "%H:%M", num(ts))
    if ok and type(s) == "string" then return s end
    return ""
  end

  local function clearMsgs()
    for _, c in ipairs(mscroll:GetChildren()) do
      if c.Name == "Row" or c.Name == "Msg" then core.safe(function() c:Destroy() end) end
    end
  end

  local function scrollEnd()
    core.delay(0.08, function()
      if u.alive() then
        core.safe(function() mscroll.CanvasPosition = Vector2.new(0, mscroll.AbsoluteCanvasSize.Y) end)
      end
    end)
  end

  renderMsgs = function(placeholder)
    clearMsgs()
    if placeholder then
      u.label(mscroll, placeholder, 0, 0, RW, 50, 12, FNT.med, C.faint, { Name = "Msg", TextXAlignment = AC })
      return
    end
    -- çizilecekler: sunucudaki son mesajlar + bu sohbetin bekleyen/başarısız mesajları
    local items = {}
    local from = math.max(1, #msgs - MAX_SHOW + 1)
    for i = from, #msgs do
      local m = msgs[i]
      items[#items + 1] = { mine = (tostring(m.f) == myKey), k = tostring(m.f), n = tostring(m.n or "?"), t = m.t, text = tostring(m.m or "") }
    end
    for _, p in ipairs(pending) do
      if current and p.file == current.file then
        items[#items + 1] = { mine = true, k = myKey, n = myNick, t = p.t, text = p.text, p = p }
      end
    end
    if #items == 0 then
      u.label(mscroll, T("empty_chat"), 0, 0, RW, 50, 12, FNT.med, C.faint, { Name = "Msg", TextXAlignment = AC })
      return
    end
    local maxBubble = RW - 90
    for i, it in ipairs(items) do
      local mine, txt = it.mine, it.text
      local th, tw = core.textHeight(txt, 13, FNT.reg, maxBubble - 20)
      local bw = math.max(48, math.min(maxBubble, math.ceil(tw) + 22))
      local bh = math.ceil(th) + 16
      local row = u.new("Frame", {
        Name = "Row", Size = UDim2.fromOffset(RW - 8, 18 + bh), BackgroundTransparency = 1, LayoutOrder = i, ZIndex = 3,
      }, mscroll)
      local who = mine and T("you") or it.n
      local isV = mine and myVip or (vipKeys[it.k] == true)
      if not mine and vipKeys[it.k] == nil and ensureVip then ensureVip(it.k) end
      if isV then who = "★ " .. who end
      local tag = hhmm(it.t)
      local failed = it.p and it.p.state == "failed"
      if it.p then tag = failed and T("failed_tag") or T("sending_tag") end
      u.label(row, who .. "  ·  " .. tag, 4, 0, RW - 16, 16, 10, FNT.med, failed and C.danger or (isV and GOLD or C.faint),
        { TextXAlignment = mine and AR or ALN, TextTruncate = TRUNC })
      local bub = u.new(failed and "TextButton" or "Frame", {
        Size = UDim2.fromOffset(bw, bh), Position = UDim2.fromOffset(mine and (RW - 8 - bw) or 0, 18),
        BackgroundColor3 = failed and C.danger or (mine and u.accent or C.card), BorderSizePixel = 0, ZIndex = 4,
        BackgroundTransparency = (it.p and not failed) and 0.45 or 0,
      }, row)
      if failed then
        core.safe(function() bub.Text = ""; bub.AutoButtonColor = false end)
        bub.MouseButton1Click:Connect(function()
          if it.p.state == "failed" then
            it.p.state = "sending"
            renderMsgs()
            if pumpQueue then pumpQueue() end
          end
        end)
        local xb = u.pill("✕", RW - 8 - bw - 28, 18 + math.floor((bh - 22) / 2), 22, 22, false, row)
        xb.TextSize = 11
        xb.MouseButton1Click:Connect(function()
          for k, q in ipairs(pending) do
            if q == it.p then table.remove(pending, k) break end
          end
          renderMsgs()
        end)
      end
      u.round(bub, 12)
      if not mine then u.stroke(bub, C.line) end
      u.label(bub, txt, 10, 8, bw - 20, math.ceil(th), 13, FNT.reg, mine and C.white or C.text,
        { TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 5 })
    end
  end

  updateHeader = function()
    if not current then hBtn.Visible = false return end
    if current.kind == "global" then
      hTitle.Text, hSub.Text = T("global"), T("global_sub")
      hBtn.Visible = false
      return
    end
    hTitle.Text = current.nick
    local st = core.friendState(fdb, myNick, current.nick)
    hSub.Text = (st == "friend") and T("st_friend") or (st == "sent") and T("st_sent") or (st == "received") and T("st_recv") or ""
    if vipKeys[current.key] then hSub.Text = (hSub.Text ~= "" and (hSub.Text .. "  ·  ") or "") .. "★ VIP"
    elseif vipKeys[current.key] == nil and ensureVip then ensureVip(current.key) end
    hBtn.Visible = true
    local label = (st == "friend") and T("b_remove") or (st == "sent") and T("b_cancel") or (st == "received") and T("b_accept") or T("b_add")
    hBtn.Text = label
    hBtn.BackgroundColor3 = (st == "received") and C.ok or C.card
    hBtn.TextColor3 = (st == "received") and C.white or C.text
  end

  hBtn.MouseButton1Click:Connect(function()
    if not current or current.kind ~= "dm" then return end
    local st = core.friendState(fdb, myNick, current.nick)
    if st == "none" then friendOp("friendRequest", current.nick)
    elseif st == "received" then friendOp("friendAccept", current.nick, "t_friend")
    else friendOp("friendRemove", current.nick, "t_removed") end
  end)

  refreshChat = function(force)
    local cur = current
    if not cur or fetching then return end
    fetching = true
    local list = core.readChat(cur.file)
    fetching = false
    if cur ~= current or not u.alive() then return end
    if #list == 0 and #msgs > 0 then   -- okuma başarısız sayılır, eldekini koru; yenileme aralığı uzar
      failStreak = failStreak + 1
      return
    end
    failStreak = 0
    -- yeni gönderdiğimiz ama sunucu okumasına henüz yansımamış mesajları koru
    local have = {}
    for _, m in ipairs(list) do have[num(m.i)] = true end
    for k = #delivered, 1, -1 do
      local d = delivered[k]
      if os.clock() - d.at > 30 then
        table.remove(delivered, k)
      elseif d.file == cur.file then
        if have[num(d.m.i)] then table.remove(delivered, k) else list[#list + 1] = d.m end
      end
    end
    table.sort(list, function(a, b) return num(a.i) < num(b.i) end)
    local lastNew = (#list > 0) and num(list[#list].i) or 0
    if force or lastNew ~= lastI or #list ~= #msgs then
      msgs, lastI = list, lastNew
      renderMsgs()
      scrollEnd()
    end
  end

  local function openChat(c)
    current = c
    msgs, lastI = {}, 0
    setChatVisible(true)
    updateHeader()
    renderMsgs(T("loading"))
    spawn(function() refreshChat(true) end)
  end

  openGlobal = function()
    openChat({ kind = "global", nick = "global", key = "global", file = core.GLOBAL_CHAT })
  end

  openDm = function(nick)
    nick = core.trim(nick)
    if nick == "" or core.nickKey(nick) == myKey then return end
    openChat({ kind = "dm", nick = nick, key = core.nickKey(nick), file = core.chatFile(myNick, nick) })
  end

  -- Başka oyuncunun VIP'liğini arka planda sorar (oturum başına en fazla 30 sorgu); VIP ise ekranı tazeler
  ensureVip = function(key)
    if vipKeys[key] ~= nil or vipLook[key] or vipLookups >= 30 then return end
    local uid = profUid[key]
    if not uid or uid <= 0 or type(core.isVip) ~= "function" then return end
    vipLook[key] = true
    vipLookups = vipLookups + 1
    spawn(function()
      local v = core.isVip(uid)
      vipKeys[key] = v and true or false
      if v and u.alive() then
        if current then renderMsgs() end
        updateHeader()
      end
    end)
  end

  local function checkIncoming(announce)
    local fl = core.friendList(fdb, myNick)
    for _, f in ipairs(fl.incoming) do
      if not knownIncoming[f.key] then
        knownIncoming[f.key] = true
        if announce then u.toast(f.nick .. T("new_req"), u.accent, 5) end
      end
    end
    for k in pairs(knownIncoming) do
      local still = false
      for _, f in ipairs(fl.incoming) do if f.key == k then still = true break end end
      if not still then knownIncoming[k] = nil end
    end
  end

  refreshFriends = function()
    local db = core.readFriends()
    if not u.alive() then return end
    applyOverrides(db)
    fdb = db
    checkIncoming(incInit)
    incInit = true
    updateTabLabels()
    renderList()
    updateHeader()
  end

  ----------------------------------------------------------
  -- Gönder
  ----------------------------------------------------------
  -- Gönderme kuyruğu: mesajlar sırayla, arka planda gönderilir
  local pumping = false
  pumpQueue = function()
    if pumping then return end
    pumping = true
    spawn(function()
      while u.alive() do
        local p = nil
        for _, q in ipairs(pending) do
          if q.state == "sending" then p = q break end
        end
        if not p then break end
        local keep = (p.file == core.GLOBAL_CHAT) and 200 or 150
        local ok, res = core.sendChat(p.file, myNick, p.text, lang, keep)
        if not u.alive() then break end
        if ok and type(res) == "table" then
          for k, q in ipairs(pending) do
            if q == p then table.remove(pending, k) break end
          end
          delivered[#delivered + 1] = { m = res, file = p.file, at = os.clock() }
          if current and current.file == p.file then
            local present = false
            for _, m in ipairs(msgs) do
              if num(m.i) == num(res.i) then present = true break end
            end
            if not present then msgs[#msgs + 1] = res; lastI = num(res.i) end
            renderMsgs()
            scrollEnd()
          end
        else
          p.state = "failed"
          if current and current.file == p.file then renderMsgs() end
          u.toast(T("fail") .. tostring(res), C.danger, 7)
        end
      end
      pumping = false
    end)
  end

  local lastEnter = 0
  local function doSend()
    if not current then return end
    local text = core.cleanText(core.trim(inBox.Text), MAX_TEXT)
    if text == "" then return end
    if os.clock() - lastEnter < 0.35 then return end   -- çift Enter/tık koruması
    local waiting = 0
    for _, q in ipairs(pending) do if q.state == "sending" then waiting = waiting + 1 end end
    if waiting >= MAX_PENDING then u.toast(T("too_many"), C.muted, 2) return end
    lastEnter = os.clock()
    nextPid = nextPid + 1
    -- HEMEN ekranda görünür; gerçek gönderim kuyrukta
    pending[#pending + 1] = { pid = nextPid, file = current.file, text = text, state = "sending", t = os.time() }
    inBox.Text = ""
    renderMsgs()
    scrollEnd()
    pumpQueue()
  end
  sendBtn.MouseButton1Click:Connect(doSend)
  inBox.FocusLost:Connect(function(enter) if enter then doSend() end end)

  u.backBtn.MouseButton1Click:Connect(function()
    local back = ctx.onBack
    u.close()
    if type(back) == "function" then back() end
  end)

  ----------------------------------------------------------
  -- İlk yükleme + yenileme döngüsü
  ----------------------------------------------------------
  styleTabs()
  renderList()

  -- kendi VIP durumum (arkadaş sınırı ve rozet için)
  spawn(function()
    if type(core.myVip) ~= "function" then return end
    myVip = core.myVip() and true or false
    if u.alive() then
      updateTabLabels()
      if current then renderMsgs(); updateHeader() end
    end
  end)

  spawn(function()
    local list = core.readPlayerList()
    local db = core.readProfiles()
    local friends = core.readFriends()
    if not u.alive() then return end
    applyOverrides(friends)
    fdb = friends
    checkIncoming(false)
    incInit = true

    local out, seen = {}, {}
    local function add(nick)
      nick = core.trim(nick)
      if nick == "" then return end
      local key = core.nickKey(nick)
      if seen[key] then return end
      seen[key] = true
      out[#out + 1] = { nick = nick, key = key }
    end
    if list then for _, r in ipairs(list) do add(r.nick) end end
    for key, p in pairs(db.profiles) do
      if type(p) == "table" then
        add(tostring(p.nick or key))
        profUid[core.nickKey(tostring(p.nick or key))] = num(p.uid)
      end
    end
    players = out
    if not list then u.toast(T("list_fail"), C.danger, 5) end
    updateTabLabels()
    renderList()

    local target = ctx.chatWith and core.trim(tostring(ctx.chatWith)) or ""
    if target ~= "" then openDm(target) end
  end)

  spawn(function()
    local tick = 0
    while u.alive() do
      sleep(1)
      tick = tick + 1
      if not u.alive() then break end
      local every = math.floor(math.min(30, POLL_CHAT * (2 ^ math.min(failStreak, 3))))
      if current and tick % every == 0 then refreshChat(false) end
      if tick % POLL_FRIENDS == 0 then refreshFriends() end
    end
  end)
end

return M
