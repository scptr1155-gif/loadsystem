    u.stroke(c, C.line)
    c.MouseEnter:Connect(function() u.tw(c, { BackgroundColor3 = C.cardHi }, 0.12) end)
    c.MouseLeave:Connect(function() u.tw(c, { BackgroundColor3 = C.card }, 0.12) end)
    u.label(c, title, 10, 8, textW or (LW - 28), 20, 13, FNT.bold, C.text, { TextTruncate = TRUNC })
    u.label(c, subtitle or "", 10, 29, textW or (LW - 28), 16, 11, FNT.med, C.muted, { TextTruncate = TRUNC })
    if onClick then c.MouseButton1Click:Connect(onClick) end
    return c
  end

  local function friendOp(fnName, nick, doneKey)
    local b = core.nickKey(nick)
    if b == "" or b == myKey then return end
    local st = core.friendState(fdb, myNick, nick)
    local row = fdb.links and fdb.links[myKey]
    local prev = type(row) == "table" and row[b] or nil
    local prevCopy = prev and { s = prev.s, from = prev.from, t = prev.t } or nil
    local v = nil
    if fnName == "friendRequest" then
      if st == "friend" then return end
      if st == "received" then v = { s = "f", from = b, t = os.time() } else v = { s = "p", from = myKey, t = os.time() } end
    elseif fnName == "friendAccept" then
      v = { s = "f", from = b, t = os.time() }
    end
    -- arkadaş sınırı (ücretsiz 5, VIP 20): dolunca sahte başarı gösterme, hemen uyar
    if fnName ~= "friendRemove" then
      local becomesFriend = (fnName == "friendAccept") or (st == "received")
      local cnt = core.friendCounts(fdb, myKey)
      local lim = core.limits(myVip).friends
      local full = becomesFriend and (cnt.friends >= lim) or ((not becomesFriend) and (cnt.friends + cnt.outgoing >= lim))
      if full then
        u.toast(core.friendLimitMsg(lang, myVip), C.danger, 7)
        return
      end
    end
    -- 1) HEMEN kendi ekranında göster
    setLink(fdb, myKey, b, v)
    if type(fdb.names) ~= "table" then fdb.names = {} end
    fdb.names[myKey] = myNick
    if fdb.names[b] == nil then fdb.names[b] = nick end
    overrides[b] = { v = v or false, exp = os.clock() + 25, nick = nick }
    local okKey = doneKey
    if fnName == "friendRequest" then okKey = (v and v.s == "f") and "t_friend" or "t_sent" end
    u.toast(T(okKey), C.ok, 3)
    updateTabLabels()
    renderList()
    updateHeader()
    -- 2) Gerçek işlem arka planda
    spawn(function()
      local ok, res = core[fnName](myNick, nick, lang)
      if not u.alive() then return end
      if ok then
        if fnName == "friendRequest" and res == "friend" and v and v.s == "p" then
          v = { s = "f", from = b, t = os.time() }
          setLink(fdb, myKey, b, v)
          overrides[b] = { v = v, exp = os.clock() + 25, nick = nick }
          u.toast(T("t_friend"), C.ok, 3)
          updateTabLabels()
          renderList()
          updateHeader()
        end
        refreshFriends()
      else
        -- başarısız: ekrandaki sahte durumu geri al
        overrides[b] = nil
        setLink(fdb, myKey, b, prevCopy)
        updateTabLabels()
        renderList()
        updateHeader()
        u.toast(T("fail") .. tostring(res), C.danger, 7)
      end
    end)
  end

  renderList = function()
    clearList()
    local q = string.lower(core.trim(searchBox.Text))

    -- Oyuncu arama sonuçları
    if q ~= "" then
      local res = {}
      for _, p in ipairs(players) do
        if p.key ~= myKey and string.find(p.key, q, 1, true) then res[#res + 1] = p end
      end
      table.sort(res, function(a, b)
        local sa, sb = (string.find(a.key, q, 1, true) == 1) and 0 or 1, (string.find(b.key, q, 1, true) == 1) and 0 or 1
        if sa ~= sb then return sa < sb end
        return a.key < b.key
      end)
      if #res == 0 then msgRow(T("none")) return end
      for i = 1, math.min(#res, 20) do
        local p = res[i]
        local st = core.friendState(fdb, myNick, p.nick)
        local sub = (st == "friend") and T("st_friend") or (st == "sent") and T("st_sent") or (st == "received") and T("st_recv") or ""
        local c = card(i, p.nick, sub, function() openDm(p.nick) end, 128)
        local mb = u.pill(T("msg"), LW - 8 - 138, 14, 62, 26, true, c)
        mb.TextSize = 11
        mb.MouseButton1Click:Connect(function() openDm(p.nick) end)
        if st == "none" then
          local ab = u.pill(T("add"), LW - 8 - 70, 14, 62, 26, false, c)
          ab.TextSize = 11
          ab.MouseButton1Click:Connect(function() friendOp("friendRequest", p.nick) end)
        elseif st == "received" then
          local ab = u.pill(T("accept"), LW - 8 - 70, 14, 62, 26, C.ok, c)
          ab.TextSize = 11
          ab.MouseButton1Click:Connect(function() friendOp("friendAccept", p.nick, "t_friend") end)
        end
      end
      return
    end

    local fl = core.friendList(fdb, myNick)

    if tab == "friends" then
      card(1, T("global"), T("global_sub"), function() openGlobal() end)
      if #fl.friends == 0 then
        msgRow(T("no_friends"), 2)
      else
        for i, f in ipairs(fl.friends) do
          card(i + 1, f.nick, T("friend_tag"), function() openDm(f.nick) end)
        end
      end
      return
    end

    -- İstekler sekmesi
    local order = 0
    if #fl.incoming == 0 and #fl.outgoing == 0 then msgRow(T("no_req")) return end
    for _, f in ipairs(fl.incoming) do
      order = order + 1
      local c = card(order, f.nick, T("in_req"), function() openDm(f.nick) end, 120)
      local ab = u.pill(T("accept"), LW - 8 - 128, 14, 62, 26, C.ok, c)
      ab.TextSize = 11
      ab.MouseButton1Click:Connect(function() friendOp("friendAccept", f.nick, "t_friend") end)
      local rb = u.pill(T("decline"), LW - 8 - 60, 14, 52, 26, C.danger, c)
      rb.TextSize = 11
      rb.MouseButton1Click:Connect(function() friendOp("friendRemove", f.nick, "t_removed") end)
    end
    for _, f in ipairs(fl.outgoing) do
      order = order + 1
      local c = card(order, f.nick, T("out_req"), function() openDm(f.nick) end, 140)
      local cb = u.pill(T("cancel_req"), LW - 8 - 76, 14, 68, 26, false, c)
      cb.TextSize = 11
      cb.MouseButton1Click:Connect(function() friendOp("friendRemove", f.nick, "t_removed") end)
    end
  end

