-- cr-chat | CR CHAT (v1.2)  -> loadsystem deposuna "cr-chat" adıyla yükle
-- =========================================================
-- main-menu'deki CR CHAT tuşu veya search-profile'daki MESAJ GÖNDER tuşu bu dosyayı indirir ve
-- open(ctx) çağırır.
--
--  * Sol: oyuncu ara (takma ad yazdıkça). Sonuçta MESAJ (özel sohbet) ve EKLE (arkadaş isteği).
--    Aramasız: ARKADAŞLAR sekmesi (GENEL SOHBET + arkadaşlar) ve İSTEKLER sekmesi (kabul / reddet / iptal).
--  * Sağ: sohbet. Mesajlar birkaç saniyede bir yenilenir. Gönder tuşu veya Enter.
--  * Veriler roblox-game-star deposunda: friends.json, chat/*.json (hubcore v1.2 içindeki fonksiyonlarla).
--
-- v1.2: VIP (pass 2075710314): sohbette VIP'lerin adının yanında ★ (altın), arkadaş sınırı gösterilir (ARKADAŞLAR 3/5)
--       ve sınır dolunca ekleme/kabul işlemi hemen uyarıyla durdurulur (VIP: 20, ücretsiz: 5). Gereken: hubcore v1.4
--
-- v1.1: İYİMSER GÖNDERİM: yazdığın mesaj / arkadaş isteği / kabul / red işlemi HEMEN kendi ekranında görünür,
--       gerçek gönderim arkada yapılır. Başarısız olursa mesaj kırmızı olur (dokun: tekrar dene, ✕: sil),
--       arkadaşlık işlemi geri alınır. Karşı taraf gerçek gönderimden sonraki yenilemede görür (birkaç sn).
--       Sana yeni arkadaşlık isteği gelince bildirim çıkar. Ekranda en fazla 80 mesaj çizilir (oyunu yormaz).
--
-- ÖNEMLİ: Sohbet dosyaları herkese açık depoda durur, gizli değildir. Mesajlar GitHub'a yazıldığı
-- için 1-3 saniye gecikmeli gelir. Gönderen adı istemciden gelir (sahte mesaj mümkündür).
--
-- ctx: { lang, accent, bg, anim, nick, player, onBack, chatWith (isteğe bağlı: bu takma adla özel sohbet aç) }

local G = (type(getgenv) == "function" and getgenv()) or _G
local S = G.__LOADSYS or {}
G.__LOADSYS = S

local BASE = "https://raw.githubusercontent.com/scptr1155-gif/loadsystem/refs/heads/main/"
local NEED = "1.4"

local function loadCore()
  if type(S.CORE) == "table" and S.CORE.version == NEED then return S.CORE end
  local ok, src = pcall(function() return game:HttpGet(BASE .. "hubcore?t=" .. tostring(os.time())) end)
  if not ok or type(src) ~= "string" or type(loadstring) ~= "function" then return nil end
  local fn = loadstring(src)
  if not fn then return nil end
  local okR, c = pcall(fn)
  if okR and type(c) == "table" then return c end
  return nil
end

