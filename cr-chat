function M.open(ctx)
  ctx = ctx or {}
  local core = loadCore()
  if not core or type(core.sendChat) ~= "function" then
    print("[cr-chat] hubcore v1.2 yuklenemedi (hubcore dosyasini guncelle)")
    if type(ctx.onBack) == "function" then ctx.onBack() end
    return
  end
  local lang = (ctx.lang == "en") and "en" or "tr"
  local function T(k) return STR[lang][k] or STR.tr[k] or k end
  local spawn, sleep, num = core.spawn, core.sleep, core.num
  local myNick = core.currentNick(ctx)
  local myKey = core.nickKey(myNick)

  local u = core.ui(ctx, { name = "Chat", title = T("title"), sub = T("sub"), back = true, backText = T("back") })
  if not u then return end
  local C, FNT = u.C, u.FNT
  local GOLD = Color3.fromRGB(250, 204, 21)
  local W, H, PAD = u.W, u.H, u.PAD
  local AC, AR, ALN = Enum.TextXAlignment.Center, Enum.TextXAlignment.Right, Enum.TextXAlignment.Left
  local TRUNC = Enum.TextTruncate.AtEnd
  local LW = 290
  local RX = PAD + LW + 14
  local RW = W - PAD - RX

  u.new("Frame", {
    Size = UDim2.fromOffset(1, H - 96), Position = UDim2.fromOffset(PAD + LW + 6, 84), BackgroundColor3 = C.line,
    BorderSizePixel = 0, ZIndex = 3,
  }, u.window)

  local function mkInput(x, y, w, h, ph, parent)
    local f = u.new("Frame", {
      Size = UDim2.fromOffset(w, h), Position = UDim2.fromOffset(x, y), BackgroundColor3 = C.card, BorderSizePixel = 0,
      ClipsDescendants = true, ZIndex = 3,
    }, parent or u.window)
    u.round(f, 10)
    u.stroke(f, C.line)
    local box = u.new("TextBox", {
      Size = UDim2.new(1, -24, 1, 0), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1, Text = "",
      PlaceholderText = ph, PlaceholderColor3 = C.faint, TextColor3 = C.text, TextSize = 13, Font = FNT.reg,
      ClearTextOnFocus = false, TextXAlignment = ALN, ZIndex = 4,
    }, f)
    return box, f
  end

