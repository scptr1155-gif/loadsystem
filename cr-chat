  local myVip, vipKeys, vipLook, profUid, vipLookups = false, {}, {}, {}, 0
  local ensureVip


  -- friends.json biçimi: links[a][b] = { s = "p"|"f", from = anahtar, t = zaman }
  local function setLink(db, a, b, v)
    if type(db.links) ~= "table" then db.links = {} end
    if type(db.links[a]) ~= "table" then db.links[a] = {} end
    if type(db.links[b]) ~= "table" then db.links[b] = {} end
    db.links[a][b] = v
    db.links[b][a] = v and { s = v.s, from = v.from, t = v.t } or nil
  end

  -- Sunucudan okunan listeye, henüz yetişmemiş kendi işlemlerimizi uygular
  local function applyOverrides(db)
    if type(db.links) ~= "table" then db.links = {} end
    if type(db.names) ~= "table" then db.names = {} end
    for b, o in pairs(overrides) do
      if os.clock() > o.exp then
        overrides[b] = nil
      else
        local row = db.links[myKey]
        local cur = type(row) == "table" and row[b] or nil
        local same = (o.v == false and cur == nil) or (o.v and type(cur) == "table" and cur.s == o.v.s and cur.from == o.v.from)
        if same then
          overrides[b] = nil
        else
          setLink(db, myKey, b, o.v or nil)
          db.names[myKey] = myNick
          if db.names[b] == nil and o.nick then db.names[b] = o.nick end
        end
      end
    end
  end

