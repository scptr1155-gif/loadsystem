function M.pad(id) return string.format("%09d", id) end
function M.num(v) return tonumber(v) or 0 end
function M.trim(s) return ((tostring(s or "")):match("^%s*(.-)%s*$")) end

function M.ulen(s)
  s = tostring(s or "")
  if type(utf8) == "table" and type(utf8.len) == "function" then
    local ok, n = pcall(utf8.len, s)
    if ok and n then return n end
  end
  return #s
end

function M.cleanText(s, maxChars)
  s = tostring(s or "")
  s = s:gsub("%c", " ")
  if type(utf8) == "table" and type(utf8.len) == "function" then
    local ok, n = pcall(utf8.len, s)
    if not ok or not n then s = s:gsub("[\128-\255]", "?") end
    if maxChars and M.ulen(s) > maxChars then
      local okO, cut = pcall(utf8.offset, s, maxChars + 1)
      if okO and cut then s = s:sub(1, cut - 1) end
    end
  elseif maxChars and #s > maxChars then
    s = s:sub(1, maxChars)
  end
  return s
end

function M.cleanCode(s)
  s = tostring(s or "")
  s = s:gsub("\239\187\191", "")
  s = s:gsub("\226\128[\139-\141]", "")
  s = s:gsub("\226\129\160", "")
  s = s:gsub("\194\160", " ")
  s = s:gsub("\r\n?", "\n")
  return s
end

function M.fixQuotes(s)
  s = s:gsub("\226\128[\156\157]", '"')
  s = s:gsub("\226\128[\152\153]", "'")
  return s
end

function M.shortErr(e)
  e = tostring(e)
  e = e:gsub('^%[string ".-"%]:', "satir ")
  return e:sub(1, 90)
end

function M.fmtTime(sec)
  if sec < 0 then sec = 0 end
  local h, m, s = math.floor(sec / 3600), math.floor((sec % 3600) / 60), math.floor(sec % 60)
  if h > 0 then return string.format("%d:%02d:%02d", h, m, s) end
  return string.format("%02d:%02d", m, s)
end

function M.userId()
  local ok, id = pcall(function() return Players.LocalPlayer.UserId end)
  return (ok and tonumber(id)) or 0
end

