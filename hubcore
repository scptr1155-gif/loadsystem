-- Bugün (UTC) yayınladıysa, yeni yayın hakkına kalan saniye; hakkı varsa 0
function M.dailyLeft(uid, idx)
  local now = os.time()
  local day = math.floor(now / 86400)
  for _, e in ipairs((idx and idx.scripts) or {}) do
    if tonumber(e.owner) == uid and math.floor(M.num(e.created) / 86400) == day then
      return (day + 1) * 86400 - now
    end
  end
  return 0
end

function M.statsFor(uid, idx)
  local st = { count = 0, uses = 0, good = 0, bad = 0, mine = {}, best = nil, rank = nil, authors = 0, last = 0 }
  local byOwner = {}
  for _, e in ipairs(idx.scripts or {}) do
    local ow = tonumber(e.owner)
    if ow then
      byOwner[ow] = (byOwner[ow] or 0) + M.num(e.uses)
      if ow == uid then
        st.count = st.count + 1
        st.uses = st.uses + M.num(e.uses)
        st.good = st.good + M.num(e.good)
        st.bad = st.bad + M.num(e.bad)
        st.mine[#st.mine + 1] = e
        if M.num(e.created) > st.last then st.last = M.num(e.created) end
        if not st.best or (M.num(e.good) - M.num(e.bad)) > (M.num(st.best.good) - M.num(st.best.bad)) then st.best = e end
      end
    end
  end
  table.sort(st.mine, function(a, b) return M.num(a.id) > M.num(b.id) end)
  local mineUses, better, total = byOwner[uid] or 0, 0, 0
  for _, v in pairs(byOwner) do
    total = total + 1
    if v > mineUses then better = better + 1 end
  end
  st.authors = total
  if st.count > 0 then st.rank = better + 1 end
  return st
end

