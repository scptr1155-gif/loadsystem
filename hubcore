--------------------------------------------------------------
local function looksLikeToken(s)
  return s:match("^github_pat_") ~= nil or s:match("^gh[pousr]_") ~= nil
end

function M.readKeys()
  local ok, src = pcall(function() return game:HttpGet(BASE .. "api-key?t=" .. tostring(os.time())) end)
  if not ok or type(src) ~= "string" or src:sub(1, 14) == "404: Not Found" then return {} end
  src = src:gsub("\239\187\191", "")
  local keys = {}
  for line in (src .. "\n"):gmatch("(.-)\n") do
    line = M.trim(line)
    if line ~= "" and line:sub(1, 1) ~= "#" then
      line = line:gsub("[\"'`]", "")
      line = line:gsub("%s+", "")
      local key
      if line:sub(1, 4) == "b64:" then
        key = b64decode(line:sub(5))
      else
        if line:sub(1, 4) == "rev:" then line = line:sub(5) end
        local reversed = line:reverse()
        if looksLikeToken(reversed) or not looksLikeToken(line) then key = reversed else key = line end
      end
      key = M.trim(key)
      key = key:gsub("^[Bb][Ee][Aa][Rr][Ee][Rr]:?%s*", "")
      key = key:gsub("^[Tt][Oo][Kk][Ee][Nn]:?%s*", "")
      key = key:gsub("%s+", "")
      if #key >= 20 then keys[#keys + 1] = key end
    end
  end
  return keys
end

function M.headers(key)
  return {
    ["Accept"] = "application/vnd.github+json", ["X-GitHub-Api-Version"] = "2022-11-28",
    ["User-Agent"] = "loadsystem-lua", ["Authorization"] = "Bearer " .. key,
    ["Content-Type"] = "application/json",
  }
end

-- fn(h) -> ok, sonuc, yetkiHatasi. Yetki hatasında sıradaki anahtar denenir.
function M.withKeys(lang, fn)
  local keys = M.readKeys()
  if #keys == 0 then return false, M.E(lang, "no_key") end
  local ok, res = false, M.E(lang, "bad_key")
  for _, k in ipairs(keys) do
    local o, r, auth = fn(M.headers(k))
    ok, res = o, r
    if o or not auth then break end
  end
  return ok, res
end

local function netErr(lang, b)
  if b == "no_req" then return M.E(lang, "no_req") end
  return M.E(lang, "net_fail") .. " (" .. tostring(b):sub(1, 60) .. ")"
end
M.netErr = netErr

-- index'i oku -> fn(idx, h) değiştirir -> geri yaz. 409/422'de yeniden dener.
-- fn: true, sonuc | false, mesaj, yetkiHatasi
function M.mutateIndex(fn, lang)
  local function E(k) return M.E(lang, k) end
  return M.withKeys(lang, function(h)
    for _ = 1, 4 do
      local c, b = req(API .. INDEX_FILE .. "?ref=" .. BRANCH .. "&t=" .. tostring(os.time()), "GET", nil, h)
      if not c then return false, netErr(lang, b) end
      local idx, sha = { next = 1, scripts = {} }, nil
      if c == 200 then
        local j = jsonDecode(b)
        if type(j) ~= "table" or not j.sha then return false, E("idx_fail") end
        sha = j.sha
        local raw = b64decode(tostring(j.content or ""))
        if M.trim(raw) ~= "" then
          local p = jsonDecode(raw)
          if type(p) ~= "table" then return false, E("idx_bad") end
          if p.scripts == nil then p.scripts = {} end
          if type(p.scripts) ~= "table" then return false, E("idx_bad") end
          idx = p
        end
      elseif c == 401 or c == 403 then
        return false, E("bad_key") .. " [" .. ghMsg(b) .. "]", true
      elseif c == 404 then
        local cr = req(REPO_API, "GET", nil, h)
        if cr == 404 then return false, E("no_repo"), true end
        if cr == 401 or cr == 403 then return false, E("bad_key"), true end
      else
        return false, E("idx_fail") .. " (HTTP " .. tostring(c) .. ")"
      end

      local ok, res, auth = fn(idx, h)
      if not ok then return false, res, auth end

      local payload = { message = "hub: index", content = b64encode(jsonEncode(idx)), branch = BRANCH }
      if sha then payload.sha = sha end
      local ci, bi = req(API .. INDEX_FILE, "PUT", jsonEncode(payload), h)
      if not ci then return false, netErr(lang, bi) end
      if ci == 200 or ci == 201 then return true, res end
      if ci == 401 or ci == 403 then return false, E("bad_key") .. " [" .. ghMsg(bi) .. "]", true end
      if ci ~= 409 and ci ~= 422 then return false, E("idx_fail") .. " (HTTP " .. tostring(ci) .. ") " .. ghMsg(bi) end
      sleep(0.6)
    end
    return false, E("conflict")
  end)
end

-- Var olan veya yeni dosyayı yaz (sha otomatik)
function M.putFile(name, content, msg, lang)
  return M.withKeys(lang, function(h)
    for _ = 1, 4 do
      local c, b = req(API .. name .. "?ref=" .. BRANCH .. "&t=" .. tostring(os.time()), "GET", nil, h)
      if not c then return false, netErr(lang, b) end
      local sha
      if c == 200 then
        local j = jsonDecode(b)
        sha = type(j) == "table" and j.sha or nil
      elseif c == 401 or c == 403 then
        return false, M.E(lang, "bad_key"), true
      elseif c ~= 404 then
        return false, M.E(lang, "write_fail") .. " (HTTP " .. tostring(c) .. ")"
      end
      local p = { message = msg, content = b64encode(content), branch = BRANCH }
      if sha then p.sha = sha end
      local cw, bw = req(API .. name, "PUT", jsonEncode(p), h)
      if not cw then return false, netErr(lang, bw) end
      if cw == 200 or cw == 201 then return true end
      if cw == 401 or cw == 403 then return false, M.E(lang, "bad_key"), true end
      if cw ~= 409 and cw ~= 422 then return false, M.E(lang, "write_fail") .. " (HTTP " .. tostring(cw) .. ") " .. ghMsg(bw) end
      sleep(0.7)
    end
    return false, M.E(lang, "conflict")
  end)
end

function M.deleteFile(name, msg, lang)
  return M.withKeys(lang, function(h)
    for _ = 1, 3 do
      local c, b = req(API .. name .. "?ref=" .. BRANCH .. "&t=" .. tostring(os.time()), "GET", nil, h)
      if not c then return false, netErr(lang, b) end
      if c == 404 then return true end
      if c == 401 or c == 403 then return false, M.E(lang, "bad_key"), true end
      if c ~= 200 then return false, M.E(lang, "write_fail") .. " (HTTP " .. tostring(c) .. ")" end
      local j = jsonDecode(b)
      local cd, bd = req(API .. name, "DELETE", jsonEncode({ message = msg, sha = j and j.sha, branch = BRANCH }), h)
      if not cd then return false, netErr(lang, bd) end
      if cd == 200 then return true end
      if cd == 401 or cd == 403 then return false, M.E(lang, "bad_key"), true end
      if cd ~= 409 and cd ~= 422 then return false, M.E(lang, "write_fail") .. " (HTTP " .. tostring(cd) .. ") " .. ghMsg(bd) end
      sleep(0.6)
    end
    return false, M.E(lang, "conflict")
  end)
end

